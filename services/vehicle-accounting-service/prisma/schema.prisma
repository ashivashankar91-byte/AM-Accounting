generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/vehicle-accounting-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// CE-12 (S074-S077) — Vehicle Inventory accounting subledger.
///
/// Ownership boundary: this service NEVER writes journal_entry/journal_line
/// itself and NEVER calls gl-service directly (CE12 GLOBAL RULES). Every
/// financial event is posted through coa-service's rule-pack-governed
/// posting engine (POST /api/v1/coa/posting-engine/events) via
/// src/infrastructure/posting-engine-client.ts. The tables below are this
/// service's OWN subsidiary ledger of record for vehicle units — the
/// "unit-level item" the epic package describes — used for cost-buildup
/// lineage, inquiry, and the $0 tie-out AC, independent of whatever
/// schedule-service open items eventually get opened once the CE-08
/// controlNumberPath -> JOURNAL_ENTRY_POSTED bridge for coa-service-
/// originated postings is built (see PENDING_UPSTREAM_TECHNICAL_
/// RECONCILIATION note on VehicleUnit.scheduleBridgeNote below and the
/// final summary of the change that introduced this service).

/// S074 — one row per physical vehicle unit ledger entity.
model VehicleUnit {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  entityId        String   @map("entity_id")
  storeId         String   @map("store_id")

  vin             String
  stockNumber     String   @map("stock_number")
  status          String   @default("NEW") // NEW | USED | DEMO | WHOLESALE
  acquisitionType String   @map("acquisition_type") // PURCHASE | TRADE_IN | DEALER_TRADE_IN | FACTORY_RECEIPT

  /// Sum of all posted VehicleCostComponent rows for this unit — maintained
  /// transactionally alongside each cost-component write so it always
  /// equals Σ(components) (S074 AC: "unit item balance = unit GL value
  /// always"). NUMERIC(15,2) — CLAUDE.md rule #1, never Float/Double.
  bookValue       Decimal  @default(0) @map("book_value") @db.Decimal(15, 2)

  /// Denormalized net LCNRV write-downs applied (informational; the write-
  /// down itself reduces bookValue directly — kept for inquiry/lineage).
  cumulativeWriteDown Decimal @default(0) @map("cumulative_write_down") @db.Decimal(15, 2)

  disposedAt      DateTime? @map("disposed_at")
  disposalType    String?   @map("disposal_type") // SOLD_RETAIL | WHOLESALE | DEALER_TRADE_OUTBOUND

  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  costComponents  VehicleCostComponent[]
  stockInEvents   VehicleStockInEvent[]
  demoReclasses   DemoReclass[]
  demoAdjustments DemoValueAdjustment[]
  lcnrvEvidence   LcnrvMarketEvidence[]
  lcnrvWriteDowns LcnrvWriteDown[]

  @@unique([tenantId, stockNumber])
  @@index([tenantId, vin])
  @@index([tenantId, entityId, status])
  @@map("vehicle_unit")
}

/// S074 — cost-buildup lineage: one row per dollar figure that contributed
/// to a unit's basis (invoice/acquisition, transport, pack, equipment,
/// reconditioning). Append-only — a correction is a new (possibly negative)
/// component row, never an update, so lineage is always reconstructable.
model VehicleCostComponent {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  unitId         String   @map("unit_id")

  componentType  String   @map("component_type") // INVOICE | TRANSPORT | PACK | EQUIPMENT | RECONDITIONING
  amount         Decimal  @db.Decimal(15, 2)
  description    String?

  /// The CE-12 SourceEventEnvelope.eventId this component was posted under
  /// — idempotency + lineage join key back to VehicleStockInEvent /
  /// VehicleReconCostEvent / VehicleCostComponentEvent.
  sourceEventId  String   @map("source_event_id")
  sourceEventType String  @map("source_event_type")

  postingExecutionId String? @map("posting_execution_id")
  journalEntryId     String? @map("journal_entry_id")
  journalNumber      String? @map("journal_number")

  createdAt      DateTime @default(now()) @map("created_at")

  unit           VehicleUnit @relation(fields: [unitId], references: [id])

  @@unique([tenantId, sourceEventId])
  @@index([tenantId, unitId])
  @@map("vehicle_cost_component")
}

/// S074 — idempotent record of every `vehicle.stocked.v1` submission (one
/// row per (tenantId, eventId): AC "duplicate stock event returns
/// original").
model VehicleStockInEvent {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  unitId             String   @map("unit_id")
  eventId            String   @map("event_id")
  correlationId      String   @map("correlation_id")

  status             String   // POSTED | REJECTED | FAILED | NO_RULE_MATCH
  postingExecutionId String?  @map("posting_execution_id")
  journalEntryId     String?  @map("journal_entry_id")
  journalNumber      String?  @map("journal_number")
  failureReason      String?  @map("failure_reason")

  requestPayload     Json     @map("request_payload")
  createdAt          DateTime @default(now()) @map("created_at")

  unit               VehicleUnit @relation(fields: [unitId], references: [id])

  @@unique([tenantId, eventId])
  @@index([tenantId, unitId])
  @@map("vehicle_stock_in_event")
}

/// S074 — `vehicle.recon-cost-added.v1`: reconditioning cost from a CE-11
/// internal RO. CE-11 is not yet integrated into this branch (epic
/// dependency register) — this event accepts a caller-supplied `roNumber`
/// and `amount` today; the real CE-11 "I-type close event carries stock#"
/// field contract is PENDING_UPSTREAM_TECHNICAL_RECONCILIATION (see
/// docs/accounting-modernization/CE12_FABLE_EPIC_PACKAGE.md dependency
/// register: "CE-11: reconditioning RO -> unit cost event field [PUTR]").
model VehicleReconCostEvent {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  unitId             String   @map("unit_id")
  eventId            String   @map("event_id")

  roNumber           String   @map("ro_number")
  amount             Decimal  @db.Decimal(15, 2)

  status             String
  postingExecutionId String?  @map("posting_execution_id")
  journalEntryId     String?  @map("journal_entry_id")
  journalNumber      String?  @map("journal_number")
  failureReason      String?  @map("failure_reason")

  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([tenantId, eventId])
  @@index([tenantId, unitId])
  @@map("vehicle_recon_cost_event")
}

/// S074 — `vehicle.cost-component-added.v1`: post-stock-in additions to
/// TRANSPORT / PACK / EQUIPMENT (each individually balanced, per the DSL's
/// "one posting group per distinct dollar figure" rule — a $0 component is
/// never submitted as its own event, see cost-math.ts).
model VehicleCostComponentEvent {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  unitId             String   @map("unit_id")
  eventId            String   @map("event_id")

  componentType      String   @map("component_type") // TRANSPORT | PACK | EQUIPMENT
  amount             Decimal  @db.Decimal(15, 2)
  packRole           String?  @map("pack_role") // PACK_INCOME | HOLDBACK_CLEARING (PACK only, SAFE_CONFIGURATION)

  status             String
  postingExecutionId String?  @map("posting_execution_id")
  journalEntryId     String?  @map("journal_entry_id")
  journalNumber      String?  @map("journal_number")
  failureReason      String?  @map("failure_reason")

  createdAt          DateTime @default(now()) @map("created_at")

  @@unique([tenantId, eventId])
  @@index([tenantId, unitId])
  @@map("vehicle_cost_component_event")
}

/// S074 — tenant-configured pack policy (SAFE_CONFIGURATION: amount/percent
/// and which clearing role pack income posts through). Never invented —
/// entered by an authorized configurator.
model VehiclePackPolicyConfig {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  entityId    String   @map("entity_id")

  packRole    String   @map("pack_role") // PACK_INCOME | HOLDBACK_CLEARING
  packBasis   String   @map("pack_basis") // FLAT | PERCENT_OF_INVOICE
  packAmount  Decimal? @map("pack_amount") @db.Decimal(15, 2)
  packPercentBp Int?   @map("pack_percent_bp") // basis points, e.g. 150 = 1.50%

  updatedBy   String   @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([tenantId, entityId])
  @@map("vehicle_pack_policy_config")
}

/// S075 — NEW -> DEMO reclass ceremony (its own journal; conserves unit
/// value).
model DemoReclass {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  unitId             String   @map("unit_id")
  eventId            String   @map("event_id")

  fromStatus         String   @map("from_status")
  toStatus            String  @map("to_status")
  unitValue          Decimal  @map("unit_value") @db.Decimal(15, 2)

  status             String
  postingExecutionId String?  @map("posting_execution_id")
  journalEntryId     String?  @map("journal_entry_id")
  journalNumber      String?  @map("journal_number")
  failureReason      String?  @map("failure_reason")

  actor              String
  idempotencyKey     String   @map("idempotency_key")
  createdAt          DateTime @default(now()) @map("created_at")

  unit               VehicleUnit @relation(fields: [unitId], references: [id])

  @@unique([tenantId, eventId])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, unitId])
  @@map("demo_reclass")
}

/// S075 — tenant-configured demo depreciation basis (SAFE_CONFIGURATION:
/// simple percentage-of-cost-per-period).
model DemoDepreciationBasisConfig {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  entityId       String   @map("entity_id")

  percentPerPeriodBp Int  @map("percent_per_period_bp") // basis points per period, e.g. 200 = 2.00%/period
  periodLengthDays   Int  @default(30) @map("period_length_days")

  updatedBy      String   @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([tenantId, entityId])
  @@map("demo_depreciation_basis_config")
}

/// S075 — preview-approve periodic demo value adjustment. Nothing auto-
/// posts: PENDING_PREVIEW -> APPROVED (accountant) -> POSTED, or REJECTED.
model DemoValueAdjustment {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  unitId             String   @map("unit_id")

  basisConfigId      String?  @map("basis_config_id")
  proposedAmount     Decimal  @map("proposed_amount") @db.Decimal(15, 2)
  computedAt         DateTime @map("computed_at")
  computedBy         String   @map("computed_by")

  status             String   @default("PENDING_PREVIEW") // PENDING_PREVIEW | APPROVED | REJECTED | POSTED | REVERSED
  approvedAmount     Decimal? @map("approved_amount") @db.Decimal(15, 2)
  approvedBy         String?  @map("approved_by")
  approvedAt         DateTime? @map("approved_at")
  rejectedReason     String?  @map("rejected_reason")

  eventId            String?  @map("event_id")
  postingExecutionId String?  @map("posting_execution_id")
  journalEntryId     String?  @map("journal_entry_id")
  journalNumber      String?  @map("journal_number")
  failureReason      String?  @map("failure_reason")
  reversalJournalEntryId String? @map("reversal_journal_entry_id")
  reversedAt         DateTime? @map("reversed_at")
  reversedBy         String?  @map("reversed_by")
  reversalReason     String?  @map("reversal_reason")

  idempotencyKey     String   @map("idempotency_key")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  unit               VehicleUnit @relation(fields: [unitId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, unitId])
  @@index([tenantId, status])
  @@map("demo_value_adjustment")
}

/// S076 — configured LCNRV write-down refusal threshold (SAFE_CONFIGURATION,
/// shared threshold config per epic text).
model LcnrvThresholdConfig {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  entityId       String   @map("entity_id")

  /// A write-down whose amount exceeds this is deterministically REFUSED
  /// (never silently capped).
  maxWriteDownAmount Decimal @map("max_write_down_amount") @db.Decimal(15, 2)

  updatedBy      String   @map("updated_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([tenantId, entityId])
  @@map("lcnrv_threshold_config")
}

/// S076 — entered/imported market-value evidence (never invented/estimated
/// by this service's own code).
model LcnrvMarketEvidence {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  unitId       String   @map("unit_id")

  marketValue  Decimal  @map("market_value") @db.Decimal(15, 2)
  source       String   // e.g. "MANHEIM_MMR", "MANUAL_APPRAISAL", "AUCTION_COMP"
  reference    String?  // external evidence reference/URL/doc id
  note         String?

  enteredBy    String   @map("entered_by")
  enteredAt    DateTime @default(now()) @map("entered_at")

  unit         VehicleUnit @relation(fields: [unitId], references: [id])

  @@index([tenantId, unitId])
  @@map("lcnrv_market_evidence")
}

/// S076 — LCNRV write-down ceremony (one-way in v1: no write-up; a
/// correction is a reversal + a fresh write-down, never a write-up event).
model LcnrvWriteDown {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  unitId             String   @map("unit_id")
  evidenceId         String   @map("evidence_id")

  bookValueBefore    Decimal  @map("book_value_before") @db.Decimal(15, 2)
  marketValue        Decimal  @map("market_value") @db.Decimal(15, 2)
  writeDownAmount    Decimal  @map("write_down_amount") @db.Decimal(15, 2)
  reason             String

  status             String   // POSTED | REFUSED
  refusalReason      String?  @map("refusal_reason")

  eventId            String?  @map("event_id")
  postingExecutionId String?  @map("posting_execution_id")
  journalEntryId     String?  @map("journal_entry_id")
  journalNumber      String?  @map("journal_number")
  failureReason      String?  @map("failure_reason")

  actor              String
  idempotencyKey     String   @map("idempotency_key")
  createdAt          DateTime @default(now()) @map("created_at")

  unit               VehicleUnit @relation(fields: [unitId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, unitId])
  @@map("lcnrv_write_down")
}

/// S077 — dealer trade (outbound or inbound leg). tradeNumber is the CE-08
/// applyNumber convention (applyNumber=trade#).
model DealerTrade {
  id                 String   @id @default(uuid())
  tenantId           String   @map("tenant_id")
  entityId           String   @map("entity_id")
  storeId            String   @map("store_id")

  tradeNumber        String   @map("trade_number")
  direction          String   // OUTBOUND | INBOUND
  counterpartyDealer String   @map("counterparty_dealer")

  /// OUTBOUND: the unit leaving. INBOUND: null until the inbound stock-in
  /// creates the arriving unit (see DealerTradeService.inbound()).
  unitId             String?  @map("unit_id")

  agreedValue        Decimal  @map("agreed_value") @db.Decimal(15, 2)
  bookValueAtTrade    Decimal? @map("book_value_at_trade") @db.Decimal(15, 2)
  gainLossAmount      Decimal? @map("gain_loss_amount") @db.Decimal(15, 2)
  gainLossDirection   String?  @map("gain_loss_direction") // GAIN | LOSS | EVEN

  status             String   @default("OPEN") // OPEN | SETTLED | CANCELLED

  eventId            String?  @map("event_id")
  postingExecutionId String?  @map("posting_execution_id")
  journalEntryId     String?  @map("journal_entry_id")
  journalNumber      String?  @map("journal_number")
  failureReason      String?  @map("failure_reason")

  actor              String
  idempotencyKey     String   @map("idempotency_key")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  settlement         DealerTradeSettlement?

  @@unique([tenantId, tradeNumber, direction])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, unitId])
  @@map("dealer_trade")
}

/// S077 — settlement nets the receivable/payable per the trade doc. Any
/// cash difference is a CE-09 concept — CE-09 is not integrated into this
/// branch, so cashDifferenceAmount is recorded as evidence and flagged
/// PENDING_UPSTREAM_TECHNICAL_RECONCILIATION, never silently posted or
/// dropped.
model DealerTradeSettlement {
  id                     String   @id @default(uuid())
  tenantId               String   @map("tenant_id")
  tradeId                String   @unique @map("trade_id")

  nettedAmount           Decimal  @map("netted_amount") @db.Decimal(15, 2)
  cashDifferenceAmount   Decimal  @default(0) @map("cash_difference_amount") @db.Decimal(15, 2)
  cashDifferencePending  Boolean  @default(false) @map("cash_difference_pending")

  status                 String   // POSTED | FAILED
  eventId                String?  @map("event_id")
  postingExecutionId     String?  @map("posting_execution_id")
  journalEntryId         String?  @map("journal_entry_id")
  journalNumber          String?  @map("journal_number")
  failureReason          String?  @map("failure_reason")

  actor                  String
  idempotencyKey         String   @map("idempotency_key")
  createdAt              DateTime @default(now()) @map("created_at")

  trade                  DealerTrade @relation(fields: [tradeId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@map("dealer_trade_settlement")
}

/// Local audit outbox — mirrors coa-service's AuditOutboxEvent shape exactly
/// (see packages/shared-kernel's AuditOutboxDrainer / makePrismaAuditOutboxStore,
/// which requires this identical id/tenantId/docType/docId/action/before/
/// after/actor/publishedAt/retryCount/lastError/createdAt shape).
model AuditOutboxEvent {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  docType     String    @map("doc_type")
  docId       String    @map("doc_id")
  action      String
  before      Json?
  after       Json?
  actor       String
  publishedAt DateTime? @map("published_at")
  retryCount  Int       @default(0) @map("retry_count")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, retryCount])
  @@map("audit_outbox")
}
