generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/cash-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// AuditPort stub outbox (S007 dependency). Shared table — every service
/// that writes audit events models this identically and creates it with
/// CREATE TABLE IF NOT EXISTS (see tenant-service/coa-service/gl-service).
/// All AMACC services share one physical Postgres database.
model AuditOutboxEvent {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  docType     String    @map("doc_type")
  docId       String    @map("doc_id")
  action      String
  before      Json?
  after       Json?
  actor       String
  publishedAt DateTime? @map("published_at")
  retryCount  Int       @default(0) @map("retry_count")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, retryCount])
  @@map("audit_outbox")
}

/// Domain-event outbox for reliable delivery of cash-service events.
/// Mirrors coa_outbox_events / tenant_outbox_events.
model CashOutboxEvent {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  eventType   String    @map("event_type")
  aggregateId String    @map("aggregate_id")
  payload     Json
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt])
  @@map("cash_outbox_events")
}

/// S052 — atomic receipt-number counter, scoped per (tenant, store,
/// businessDate). Allocated via a single INSERT..ON CONFLICT DO UPDATE..
/// RETURNING statement (see application/receipt-sequence-service.ts) —
/// mirrors coa-service's JournalSequence exactly, including why: a separate
/// find+create+update sequence aborts the whole Postgres transaction for
/// every losing concurrent caller (see that file's header comment).
model CashReceiptSequence {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  storeId      String   @map("store_id")
  businessDate DateTime @map("business_date") @db.Date
  nextSeq      Int      @default(1) @map("next_seq")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, storeId, businessDate])
  @@map("cash_receipt_sequence")
}

/// S052 — a cashier's drawer session at one terminal for one business date.
/// One cashier owns one drawer; drawer handoff is out of scope for this
/// slice. "Active" = status <> RECONCILED. Two partial unique indexes
/// (added in the RLS/constraints migration — not expressible in the Prisma
/// DSL) enforce, at the DB level: one active drawer per (tenant, cashier,
/// store) and one active drawer per (tenant, terminal).
///
/// Status lifecycle: OPEN -> BLIND_COUNT_SUBMITTED -> [VARIANCE_REVIEW_REQUIRED ->]
/// BLIND_COUNT_SUBMITTED -> RECONCILED. VARIANCE_REVIEW_REQUIRED is only
/// entered when the computed variance requires supervisor approval; approving
/// it returns the drawer to BLIND_COUNT_SUBMITTED (now reconcile-eligible).
/// RECONCILED is terminal — permanently read-only.
model CashDrawer {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  entityId       String    @map("entity_id")
  storeId        String    @map("store_id")
  storeCode      String    @map("store_code") @db.VarChar(20)
  terminalCode   String    @map("terminal_code") @db.VarChar(20)
  cashierId      String    @map("cashier_id")
  cashierName    String?   @map("cashier_name")
  businessDate   DateTime  @map("business_date") @db.Date
  currency       String    @default("USD") @db.VarChar(3)
  openingFloat   Decimal   @map("opening_float") @db.Decimal(15, 2)
  floatLocked    Boolean   @default(false) @map("float_locked")
  retainedFloat  Decimal?  @map("retained_float") @db.Decimal(15, 2)
  status         String    @default("OPEN") // OPEN | BLIND_COUNT_SUBMITTED | VARIANCE_REVIEW_REQUIRED | RECONCILED
  openedBy       String    @map("opened_by")
  openedAt       DateTime  @default(now()) @map("opened_at")
  reconciledBy   String?   @map("reconciled_by")
  reconciledAt   DateTime? @map("reconciled_at")
  version        Int       @default(1)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  receipts    CashReceipt[]
  movements   CashDrawerMovement[]
  blindCount  CashBlindCount?
  variance    CashDrawerVariance?
  approval    CashVarianceApproval?

  @@index([tenantId, cashierId, status])
  @@index([tenantId, terminalCode, status])
  @@index([tenantId, storeId, businessDate])
  @@map("cash_drawer")
}

/// S052 — an immutable point-of-sale receipt. Financial fields (totalAmount,
/// tenders, sourceDocType/sourceDocId, amountDue) never change after issue;
/// the only correction path is voidReceipt(), which preserves this row and
/// writes compensating CashDrawerMovement rows.
model CashReceipt {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  entityId            String    @map("entity_id")
  storeId             String    @map("store_id")
  drawerId            String    @map("drawer_id")
  receiptNumber       String    @map("receipt_number")
  status              String    @default("ISSUED") // ISSUED | VOIDED
  sourceDocType       String    @map("source_doc_type")
  sourceDocId         String    @map("source_doc_id")
  sourceDisplayNumber String?   @map("source_display_number")
  payerReference      String?   @map("payer_reference")
  amountDue           Decimal?  @map("amount_due") @db.Decimal(15, 2)
  totalAmount         Decimal   @map("total_amount") @db.Decimal(15, 2)
  currency            String    @default("USD") @db.VarChar(3)
  cashierId           String    @map("cashier_id")
  idempotencyKey      String    @map("idempotency_key")
  issuedAt            DateTime  @default(now()) @map("issued_at")
  voidedAt            DateTime? @map("voided_at")
  voidReason          String?   @map("void_reason")
  voidedBy            String?   @map("voided_by")
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")

  drawer  CashDrawer            @relation(fields: [drawerId], references: [id])
  tenders CashReceiptTender[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, entityId, receiptNumber])
  @@index([tenantId, drawerId])
  @@index([tenantId, sourceDocType, sourceDocId])
  @@index([tenantId, status])
  @@index([tenantId, storeId, issuedAt])
  @@map("cash_receipt")
}

model CashReceiptTender {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  receiptId    String   @map("receipt_id")
  tenderType   String   @map("tender_type") // CASH | CHECK
  amount       Decimal  @db.Decimal(15, 2)
  cashTendered Decimal? @map("cash_tendered") @db.Decimal(15, 2)
  changeGiven  Decimal? @map("change_given") @db.Decimal(15, 2)
  checkNumber  String?  @map("check_number")
  checkPayer   String?  @map("check_payer")
  createdAt    DateTime @default(now()) @map("created_at")

  receipt CashReceipt @relation(fields: [receiptId], references: [id])

  @@index([tenantId, receiptId])
  @@map("cash_receipt_tender")
}

/// S052 — append-only drawer ledger. Every cash/check movement in or out of
/// the drawer (opening float, receipt tenders, void compensations) is one
/// row here; expected cash/checks at blind-close time are ALWAYS derived by
/// summing this table, never from a running balance column. INSERT-only —
/// enforced by the trg_cash_drawer_movement_append_only trigger (added in
/// the constraints migration).
model CashDrawerMovement {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  drawerId     String   @map("drawer_id")
  movementType String   @map("movement_type") // OPEN_FLOAT | CASH_RECEIPT | CASH_VOID_REVERSAL | CHECK_RECEIPT | CHECK_VOID_REVERSAL
  amount       Decimal  @db.Decimal(15, 2) // signed: void reversals are negative
  tenderType   String?  @map("tender_type") // CASH | CHECK | null for OPEN_FLOAT
  receiptId    String?  @map("receipt_id")
  checkNumber  String?  @map("check_number")
  createdAt    DateTime @default(now()) @map("created_at")

  drawer CashDrawer @relation(fields: [drawerId], references: [id])

  @@index([tenantId, drawerId, movementType])
  @@index([tenantId, receiptId])
  @@map("cash_drawer_movement")
}

/// S052 — the cashier's blind count submission. Cashier-entered fields only
/// (countedCash/checkCount/checkTotal/retainedFloat/cashierNote) — expected
/// totals are computed server-side from CashDrawerMovement and never echoed
/// back in the response to this submission (BR: cashier must not see
/// expected totals before submitting).
model CashBlindCount {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  drawerId      String   @unique @map("drawer_id")
  countedCash   Decimal  @map("counted_cash") @db.Decimal(15, 2)
  checkCount    Int      @map("check_count")
  checkTotal    Decimal  @map("check_total") @db.Decimal(15, 2)
  retainedFloat Decimal  @map("retained_float") @db.Decimal(15, 2)
  cashierNote   String?  @map("cashier_note")
  submittedBy   String   @map("submitted_by")
  submittedAt   DateTime @default(now()) @map("submitted_at")
  version       Int      @default(1)

  drawer CashDrawer            @relation(fields: [drawerId], references: [id])
  lines  CashBlindCountLine[]

  @@map("cash_blind_count")
}

/// Itemized counted checks (BR: check reconciliation needs expected vs
/// counted check COUNT and TOTAL, not just a lump sum).
model CashBlindCountLine {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  blindCountId String   @map("blind_count_id")
  checkNumber  String?  @map("check_number")
  amount       Decimal  @db.Decimal(15, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  blindCount CashBlindCount @relation(fields: [blindCountId], references: [id])

  @@index([tenantId, blindCountId])
  @@map("cash_blind_count_line")
}

/// S052 — computed once at blind-close submission time (never recomputed),
/// from CashDrawerMovement (cash) and CashBlindCountLine (checks). A check
/// discrepancy is classified NON_CASH_EXCEPTION and never folded into a cash
/// over/short — see domain/reconciliation.ts classifyVariance().
model CashDrawerVariance {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  drawerId            String   @unique @map("drawer_id")
  expectedCash        Decimal  @map("expected_cash") @db.Decimal(15, 2)
  countedCash         Decimal  @map("counted_cash") @db.Decimal(15, 2)
  cashVariance        Decimal  @map("cash_variance") @db.Decimal(15, 2)
  toleranceApplied    Decimal  @map("tolerance_applied") @db.Decimal(15, 2)
  classification      String   // EXACT | WITHIN_TOLERANCE | OUTSIDE_TOLERANCE | NON_CASH_EXCEPTION
  expectedCheckCount  Int      @map("expected_check_count")
  expectedCheckTotal  Decimal  @map("expected_check_total") @db.Decimal(15, 2)
  countedCheckCount   Int      @map("counted_check_count")
  countedCheckTotal   Decimal  @map("counted_check_total") @db.Decimal(15, 2)
  checkDiscrepancy    Boolean  @map("check_discrepancy")
  requiresApproval    Boolean  @map("requires_approval")
  depositEligibleCash Decimal  @map("deposit_eligible_cash") @db.Decimal(15, 2)
  createdAt           DateTime @default(now()) @map("created_at")

  drawer CashDrawer @relation(fields: [drawerId], references: [id])

  @@map("cash_drawer_variance")
}

model CashVarianceApproval {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  drawerId        String   @unique @map("drawer_id")
  varianceId      String   @map("variance_id")
  approvedBy      String   @map("approved_by")
  approvalReason  String   @map("approval_reason")
  approvedAt      DateTime @default(now()) @map("approved_at")

  drawer CashDrawer @relation(fields: [drawerId], references: [id])

  @@map("cash_variance_approval")
}

/// Scoped, resolvable cash-drawer variance tolerance. Resolution order
/// STORE -> ENTITY -> TENANT -> 0.00 (no configured tolerance = only an
/// exact count avoids OUTSIDE_TOLERANCE). Mirrors coa-service's
/// ConfigKeyCatalog/ConfigSetting shape, simplified to a single table since
/// this is a standalone service (see S052 research report Q9). The
/// (tenant_id, scope, COALESCE(scope_id,'')) uniqueness is enforced by a
/// raw unique index in the constraints migration, following the same
/// COALESCE-in-unique-index technique as authz_role_assignment.
model CashVarianceToleranceConfig {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  scope           String   // TENANT | ENTITY | STORE
  scopeId         String?  @map("scope_id") // null for TENANT scope
  toleranceAmount Decimal  @map("tolerance_amount") @db.Decimal(15, 2)
  updatedBy       String   @map("updated_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([tenantId, scope, scopeId])
  @@map("cash_variance_tolerance_config")
}

/// S053 — a deposit batch of undeposited cash receipts bound for one bank
/// account. Lifecycle: OPEN (accumulating lines) -> POSTED (clearing->cash
/// journal emitted, immutable) or -> VOID (cancelled before posting, never
/// after). idempotencyKey guards double-posting the same logical deposit
/// action; CashDepositLine's (tenantId, receiptId) unique constraint is the
/// DB-level guard that a receipt can never be deposited twice.
model CashDeposit {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  entityId        String    @map("entity_id")
  storeId         String    @map("store_id")
  bankAccountCode String    @map("bank_account_code")
  businessDate    DateTime  @map("business_date") @db.Date
  currency        String    @default("USD") @db.VarChar(3)
  status          String    @default("OPEN") // OPEN | POSTED | VOID
  totalAmount     Decimal   @map("total_amount") @db.Decimal(15, 2)
  idempotencyKey  String    @map("idempotency_key")
  preparedBy      String    @map("prepared_by")
  preparedAt      DateTime  @default(now()) @map("prepared_at")
  postedBy        String?   @map("posted_by")
  postedAt        DateTime? @map("posted_at")
  voidedBy        String?   @map("voided_by")
  voidedAt        DateTime? @map("voided_at")
  voidReason      String?   @map("void_reason")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")

  lines CashDepositLine[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, storeId, businessDate])
  @@index([tenantId, status])
  @@map("cash_deposit")
}

/// S053 — one deposited receipt within a batch. (tenantId, receiptId) is
/// unique tenant-wide: a receipt can belong to at most one deposit, ever
/// (enforced at the DB level, not just app logic).
model CashDepositLine {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  depositId  String   @map("deposit_id")
  receiptId  String   @map("receipt_id")
  tenderType String   @map("tender_type") // CASH | CHECK
  amount     Decimal  @db.Decimal(15, 2)
  createdAt  DateTime @default(now()) @map("created_at")

  deposit CashDeposit @relation(fields: [depositId], references: [id])

  @@unique([tenantId, receiptId])
  @@index([tenantId, depositId])
  @@map("cash_deposit_line")
}

/// S053 — a bank statement/feed line, manually imported (always available)
/// or pushed by a real feed adapter (BANK_FEED_NOT_CONFIGURED today — no
/// adapter is wired; see infrastructure/bank-feed-adapter.ts). Matched
/// against a CashDeposit (clearing) or a CashReceipt (pre-deposit match).
model BankFeedLine {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  bankAccountCode  String    @map("bank_account_code")
  source           String    @default("MANUAL") // MANUAL | FEED
  externalId       String?   @map("external_id")
  amount           Decimal   @db.Decimal(15, 2)
  valueDate        DateTime  @map("value_date") @db.Date
  description      String?
  status           String    @default("UNMATCHED") // UNMATCHED | MATCHED | IGNORED
  matchedDepositId String?   @map("matched_deposit_id")
  matchedReceiptId String?   @map("matched_receipt_id")
  matchedBy        String?   @map("matched_by")
  matchedAt        DateTime? @map("matched_at")
  importedBy       String    @map("imported_by")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@unique([tenantId, bankAccountCode, externalId])
  @@index([tenantId, status])
  @@index([tenantId, bankAccountCode])
  @@map("bank_feed_line")
}

/// S055 — one merchant card-settlement batch, manually imported (adapter;
/// no real processor wired here — see infrastructure/settlement-adapter.ts)
/// or matched to card-tender receipts/deposits from S053. gross/fees/net
/// are all stated on the batch; fee recognition always posts its own
/// journal line (cash.settlement.fee.recognized) — never silently netted
/// into the deposit.
model SettlementBatch {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  entityId        String    @map("entity_id")
  bankAccountCode String    @map("bank_account_code")
  processorName   String    @map("processor_name")
  batchReference  String    @map("batch_reference")
  settlementDate  DateTime  @map("settlement_date") @db.Date
  currency        String    @default("USD") @db.VarChar(3)
  grossAmount     Decimal   @map("gross_amount") @db.Decimal(15, 2)
  feeAmount       Decimal   @map("fee_amount") @db.Decimal(15, 2)
  netAmount       Decimal   @map("net_amount") @db.Decimal(15, 2)
  status          String    @default("IMPORTED") // IMPORTED | MATCHED | POSTED | VOID
  idempotencyKey  String    @map("idempotency_key")
  importedBy      String    @map("imported_by")
  importedAt      DateTime  @default(now()) @map("imported_at")
  postedBy        String?   @map("posted_by")
  postedAt        DateTime? @map("posted_at")
  version         Int       @default(1)
  createdAt       DateTime  @default(now()) @map("created_at")

  lines       SettlementBatchLine[]
  chargebacks SettlementChargeback[]

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, processorName, batchReference])
  @@index([tenantId, status])
  @@map("settlement_batch")
}

/// S055 — a single card-tender receipt/deposit matched into a settlement
/// batch. Unmatched settlement lines never get folded silently into a
/// batch — they stay in the SettlementWorklistItem table below until an
/// explicit match action.
model SettlementBatchLine {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  batchId    String   @map("batch_id")
  receiptId  String?  @map("receipt_id")
  depositId  String?  @map("deposit_id")
  amount     Decimal  @db.Decimal(15, 2)
  matchedBy  String   @map("matched_by")
  matchedAt  DateTime @default(now()) @map("matched_at")

  batch SettlementBatch @relation(fields: [batchId], references: [id])

  @@index([tenantId, batchId])
  @@map("settlement_batch_line")
}

/// S055 AC: unmatched settlement lines land in an explicit worklist, never
/// auto-absorbed into a batch or silently dropped.
model SettlementWorklistItem {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  batchId         String?   @map("batch_id")
  bankAccountCode String    @map("bank_account_code")
  amount          Decimal   @db.Decimal(15, 2)
  cardLast4       String?   @map("card_last4")
  transactionRef  String?   @map("transaction_ref")
  status          String    @default("OPEN") // OPEN | RESOLVED | IGNORED
  resolvedBy      String?   @map("resolved_by")
  resolvedAt      DateTime? @map("resolved_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@index([tenantId, status])
  @@map("settlement_worklist_item")
}

/// S055 — a governed chargeback disposition. Exactly one
/// SettlementAdjustment (below) is created per chargeback, per an explicit
/// disposition action — never automatically. PUTR: this is modeled as a
/// local settlement-adjustment record; it is NOT an AR open item. When
/// apar-service exposes a reachable "create customer-responsibility item"
/// endpoint, this record's disposition should call it — documented here as
/// the integration point, not invented today.
model SettlementChargeback {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  batchId             String?   @map("batch_id")
  entityId            String    @map("entity_id")
  customerId          String?   @map("customer_id")
  amount              Decimal   @db.Decimal(15, 2)
  reasonCode          String?   @map("reason_code")
  status              String    @default("INTAKE") // INTAKE | DISPOSITIONED
  dispositionAction    String?   @map("disposition_action") // CUSTOMER_RESPONSIBILITY | MERCHANT_ABSORBED
  dispositionedBy      String?   @map("dispositioned_by")
  dispositionedAt      DateTime? @map("dispositioned_at")
  createdAt           DateTime  @default(now()) @map("created_at")

  batch       SettlementBatch?        @relation(fields: [batchId], references: [id])
  adjustment  SettlementAdjustment?

  @@index([tenantId, status])
  @@map("settlement_chargeback")
}

/// S055 — one governed adjustment + (when disposition =
/// CUSTOMER_RESPONSIBILITY) one customer-responsibility item, created
/// exactly once per chargeback via the unique FK to SettlementChargeback.
/// PUTR note (see model comment above): `arItemReference` is populated only
/// once apar-service's AR-item-creation endpoint is reachable; until then
/// it stays null and this row IS the customer-responsibility record.
model SettlementAdjustment {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  chargebackId    String   @unique @map("chargeback_id")
  entityId        String   @map("entity_id")
  amount          Decimal  @db.Decimal(15, 2)
  dispositionAction String @map("disposition_action")
  arItemReference String?  @map("ar_item_reference") // PUTR — populated once apar-service integration lands
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  chargeback SettlementChargeback @relation(fields: [chargebackId], references: [id])

  @@map("settlement_adjustment")
}

/// S056 — tenant-configured pair of accounts a ZBA sweep moves cash
/// between (store <-> operating). One row per configured pair.
model SweepAccountPairConfig {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  entityId          String   @map("entity_id")
  storeAccountCode  String   @map("store_account_code")
  operatingAccountCode String @map("operating_account_code")
  active            Boolean  @default(true)
  createdBy         String   @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  sweeps ZbaSweep[]

  @@unique([tenantId, storeAccountCode, operatingAccountCode])
  @@map("sweep_account_pair_config")
}

/// S056 — one ZBA sweep event between the configured pair. direction
/// STORE_TO_OPERATING sweeps the store account down to zero into
/// operating; OPERATING_TO_STORE funds the store account back up.
/// confirmationState is truthful: FEED_CONFIRMED only when a real bank feed
/// match exists, otherwise MANUAL_RECORDED. AC: the posted journal pair
/// (see cash.sweep.posted event) nets exactly zero across the two accounts.
model ZbaSweep {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  pairConfigId      String    @map("pair_config_id")
  sweepDate         DateTime  @map("sweep_date") @db.Date
  direction         String    // STORE_TO_OPERATING | OPERATING_TO_STORE
  amount            Decimal   @db.Decimal(15, 2)
  confirmationState String    @default("MANUAL_RECORDED") @map("confirmation_state") // MANUAL_RECORDED | FEED_CONFIRMED
  status            String    @default("RECORDED") // RECORDED | POSTED | VOID
  idempotencyKey    String    @map("idempotency_key")
  recordedBy        String    @map("recorded_by")
  recordedAt        DateTime  @default(now()) @map("recorded_at")
  postedAt          DateTime? @map("posted_at")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")

  pairConfig SweepAccountPairConfig @relation(fields: [pairConfigId], references: [id])

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@map("zba_sweep")
}

/// S056 — floorplan-offset allocation: a manually entered lender-statement
/// figure allocated against floorplan interest lines. Pure allocation of
/// entered numbers — no interest calculation/actuarial math is performed
/// here (explicitly out of scope). AC: sum(lines.amount) == statementAmount
/// exactly.
model FpOffsetAllocation {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  entityId          String   @map("entity_id")
  lenderName        String   @map("lender_name")
  statementDate     DateTime @map("statement_date") @db.Date
  statementAmount   Decimal  @map("statement_amount") @db.Decimal(15, 2)
  status            String   @default("DRAFT") // DRAFT | POSTED
  idempotencyKey    String   @map("idempotency_key")
  enteredBy         String   @map("entered_by")
  enteredAt         DateTime @default(now()) @map("entered_at")
  postedAt          DateTime? @map("posted_at")
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at")

  lines FpOffsetAllocationLine[]

  @@unique([tenantId, idempotencyKey])
  @@map("fp_offset_allocation")
}

model FpOffsetAllocationLine {
  id             String  @id @default(uuid())
  tenantId       String  @map("tenant_id")
  allocationId   String  @map("allocation_id")
  floorplanUnitRef String @map("floorplan_unit_ref")
  amount         Decimal @db.Decimal(15, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  allocation FpOffsetAllocation @relation(fields: [allocationId], references: [id])

  @@index([tenantId, allocationId])
  @@map("fp_offset_allocation_line")
}

/// S057 — per-tenant/jurisdiction statutory large-cash-transaction
/// threshold. Empty table = no flags, never guessed (BR — this is a
/// governed configuration value, not a hardcoded constant).
model LargeCashThresholdConfig {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  jurisdiction   String
  thresholdAmount Decimal @map("threshold_amount") @db.Decimal(15, 2)
  currency       String   @default("USD") @db.VarChar(3)
  updatedBy      String   @map("updated_by")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([tenantId, jurisdiction])
  @@map("large_cash_threshold_config")
}

/// S057 — an audited export of the daily cash position report. The export
/// itself contains no financial computation — it is a retained, audited
/// record of a read-model snapshot already composed elsewhere.
model CashPositionExport {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  entityId     String   @map("entity_id")
  businessDate DateTime @map("business_date") @db.Date
  requestedBy  String   @map("requested_by")
  requestedAt  DateTime @default(now()) @map("requested_at")
  snapshot     Json

  @@index([tenantId, entityId, businessDate])
  @@map("cash_position_export")
}
