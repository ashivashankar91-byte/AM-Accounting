generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/payroll-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Stream 3 — Full Payroll Module

model Employee {
  id                  String        @id @default(cuid())
  tenantId            String        @map("tenant_id")
  /// @net-new fix(integration): real legal-entity ownership (tenant-service's
  /// LegalEntity.id — cross-service, no DB-level FK). Nullable because
  /// existing rows predate this dimension and cannot be unambiguously
  /// backfilled; a null value blocks the employee from being added to any
  /// NEW payroll batch item until reconciled (LEGAL_ENTITY_RECONCILIATION_REQUIRED).
  legalEntityId       String?       @map("legal_entity_id")
  employeeCode        String        @map("employee_code")
  firstName           String        @map("first_name")
  lastName            String        @map("last_name")
  department          String
  payType             String        @map("pay_type")
  payRate             Decimal?      @map("pay_rate")        @db.Decimal(15, 4)
  commissionRate      Decimal?      @map("commission_rate") @db.Decimal(5, 4)
  payFrequency        String        @default("BI_WEEKLY")   @map("pay_frequency")
  federalFilingStatus String        @default("SINGLE")      @map("federal_filing_status")
  stateCode           String?       @map("state_code")
  federalAllowances   Int           @default(0)             @map("federal_allowances")
  stateAllowances     Int           @default(0)             @map("state_allowances")
  isActive            Boolean       @default(true)          @map("is_active")
  hireDate            DateTime      @map("hire_date")
  terminationDate     DateTime?     @map("termination_date")
  defaultGlDept       String?       @map("default_gl_dept")
  createdAt           DateTime      @default(now())         @map("created_at")
  updatedAt           DateTime      @updatedAt              @map("updated_at")

  payItems   PayrollItem[]
  ytdRecords EmployeeYTD[]

  @@unique([tenantId, employeeCode])
  @@map("employees")
  @@index([tenantId, department, isActive])
  @@index([tenantId, legalEntityId])
}

model PayrollBatch {
  id               String    @id @default(cuid())
  tenantId         String    @map("tenant_id")
  /// @net-new fix(integration): real legal-entity ownership — replaces the
  /// temporary legalEntityId=tenantId substitution used before this fix.
  /// Persisted at batch-creation time from the authorized request context
  /// (never client-trusted in isolation — see security.ts's entity scope
  /// extractor) and is the SOLE source of the legalEntityId every
  /// PAYROLL_BATCH_POSTED/REVERSED event now carries. Null only for rows
  /// that predate this dimension (LEGAL_ENTITY_RECONCILIATION_REQUIRED —
  /// blocked from validate/approve/post/void until backfilled).
  legalEntityId    String?   @map("legal_entity_id")
  batchNumber      String    @map("batch_number")
  payPeriodStart   DateTime  @map("pay_period_start")
  payPeriodEnd     DateTime  @map("pay_period_end")
  payDate          DateTime  @map("pay_date")
  payFrequency     String    @map("pay_frequency")
  status           String    @default("DRAFT")
  totalGrossPay    Decimal   @default(0) @map("total_gross_pay")    @db.Decimal(15, 2)
  totalDeductions  Decimal   @default(0) @map("total_deductions")   @db.Decimal(15, 2)
  totalNetPay      Decimal   @default(0) @map("total_net_pay")      @db.Decimal(15, 2)
  totalEmployerTax Decimal   @default(0) @map("total_employer_tax") @db.Decimal(15, 2)
  employeeCount    Int       @default(0) @map("employee_count")
  journalEntryId   String?   @map("journal_entry_id")
  approvedBy       String?   @map("approved_by")
  approvedAt       DateTime? @map("approved_at")
  postedAt         DateTime? @map("posted_at")
  voidedAt         DateTime? @map("voided_at")
  voidReason       String?   @map("void_reason")
  /// @net-new CE-13/S108: hold/release workflow (validated batches may be
  /// held before approval — e.g. pending manual correction — and released
  /// back to VALIDATED; a held batch cannot be approved or posted).
  holdReason       String?   @map("hold_reason")
  heldBy           String?   @map("held_by")
  heldAt           DateTime? @map("held_at")
  createdBy        String    @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt      @map("updated_at")

  /// @net-new CE-13/S108: statutory-boundary + governed-posting + duplicate-run additions.
  payrollSourceMode  String    @default("NOT_CONFIGURED") @map("payroll_source_mode")
  providerRunId      String?   @map("provider_run_id")
  glDraftJournalId   String?   @map("gl_draft_journal_id")
  rulePackVersionId  String?   @map("rule_pack_version_id")
  reversalOfBatchId  String?   @map("reversal_of_batch_id")
  reversedByBatchId  String?   @map("reversed_by_batch_id")
  isAdjustmentRun    Boolean   @default(false) @map("is_adjustment_run")

  items PayrollItem[]

  @@unique([tenantId, batchNumber])
  @@unique([tenantId, legalEntityId, providerRunId, payPeriodStart, payPeriodEnd])
  @@map("payroll_batches")
  @@index([tenantId, status])
  @@index([tenantId, payDate])
  @@index([tenantId, legalEntityId])
}

model PayrollItem {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  /// @net-new fix(integration): denormalized copy of the parent batch's
  /// legalEntityId (set once, at item-creation time, from the batch —
  /// never independently client-supplied) so items can be indexed/queried
  /// by entity without a join, and so "cannot mix legal entities" is
  /// enforced by comparing this to the employee's own legalEntityId.
  legalEntityId    String?  @map("legal_entity_id")
  batchId          String   @map("batch_id")
  batch            PayrollBatch @relation(fields: [batchId], references: [id])
  employeeId       String   @map("employee_id")
  employee         Employee @relation(fields: [employeeId], references: [id])
  department       String

  regularHours     Decimal? @map("regular_hours")  @db.Decimal(8, 2)
  overtimeHours    Decimal? @map("overtime_hours") @db.Decimal(8, 2)
  regularPay       Decimal  @default(0) @map("regular_pay")    @db.Decimal(15, 2)
  overtimePay      Decimal  @default(0) @map("overtime_pay")   @db.Decimal(15, 2)
  commissionPay    Decimal  @default(0) @map("commission_pay") @db.Decimal(15, 2)
  bonusPay         Decimal  @default(0) @map("bonus_pay")      @db.Decimal(15, 2)
  otherPay         Decimal  @default(0) @map("other_pay")      @db.Decimal(15, 2)
  grossPay         Decimal  @default(0) @map("gross_pay")      @db.Decimal(15, 2)

  federalTax       Decimal  @default(0) @map("federal_tax")      @db.Decimal(15, 2)
  stateTax         Decimal  @default(0) @map("state_tax")        @db.Decimal(15, 2)
  socialSecurity   Decimal  @default(0) @map("social_security")  @db.Decimal(15, 2)
  medicare         Decimal  @default(0) @map("medicare")         @db.Decimal(15, 2)
  otherDeductions  Decimal  @default(0) @map("other_deductions") @db.Decimal(15, 2)
  totalDeductions  Decimal  @default(0) @map("total_deductions") @db.Decimal(15, 2)
  netPay           Decimal  @default(0) @map("net_pay")          @db.Decimal(15, 2)

  employerFICA     Decimal  @default(0) @map("employer_fica")     @db.Decimal(15, 2)
  employerMedicare Decimal  @default(0) @map("employer_medicare") @db.Decimal(15, 2)
  employerFUTA     Decimal  @default(0) @map("employer_futa")     @db.Decimal(15, 2)
  employerSUTA     Decimal  @default(0) @map("employer_suta")     @db.Decimal(15, 2)
  totalEmployerTax Decimal  @default(0) @map("total_employer_tax") @db.Decimal(15, 2)

  glAccountCode    String?  @map("gl_account_code")
  glDepartment     String?  @map("gl_department")

  /// @net-new CE-13/S025 statutory boundary — withholding lines are never
  /// computed here; they only carry ATTESTED_MANUAL_ENTRY or TEST_FIXTURE
  /// figures until resolved (see domain/payroll-adapter-contract.ts).
  withholdingStatus   String    @default("NOT_CONFIGURED") @map("withholding_status")
  withholdingSource   String?   @map("withholding_source")
  attestedBy          String?   @map("attested_by")
  attestedAt          DateTime? @map("attested_at")
  sourceDocumentRef   String?   @map("source_document_ref")

  createdAt        DateTime @default(now()) @map("created_at")

  @@map("payroll_items")
  @@index([tenantId, batchId])
  @@index([tenantId, employeeId])
  @@index([tenantId, legalEntityId])
}

/// @net-new CE-13/S025 — per-tenant payroll statutory-source configuration.
/// Truthful default is NOT_CONFIGURED (NullPayrollSource). Setting this to
/// MANUAL_ATTESTED enables the attested-entry path; TEST_FIXTURE is
/// restricted at the domain layer to the labeled certification tenant.
/// fix(integration): entity-scoped config rows (legalEntityId set) are now
/// the write path going forward; the original tenant-wide row
/// (legalEntityId null) is preserved as a legacy default/fallback only —
/// never silently reinterpreted as belonging to a specific entity.
model PayrollTenantConfig {
  id                String   @id @default(cuid())
  tenantId          String   @map("tenant_id")
  legalEntityId     String?  @map("legal_entity_id")
  payrollSourceMode String   @default("NOT_CONFIGURED") @map("payroll_source_mode")
  /// @net-new fix(integration) CE-09 handoff — NOT_CONFIGURED (truthful
  /// default: no payment method decided) | MANUAL_EXPORT (payroll marks the
  /// posted liability export-ready for a real external/manual disbursement
  /// process; never claims transmission or settlement itself).
  paymentHandoffMode String  @default("NOT_CONFIGURED") @map("payment_handoff_mode")
  updatedBy         String?  @map("updated_by")
  updatedAt         DateTime @updatedAt @map("updated_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([tenantId, legalEntityId])
  @@map("payroll_tenant_config")
}

/// @net-new fix(integration) — CE-09 payroll payment handoff. Narrow: this
/// table records the STATE of handing a posted payroll liability off to a
/// real external/CE-09 disbursement and settlement process. It never
/// constructs a payment rail file, never claims ACH transmission, and never
/// fabricates a bank acknowledgment — SETTLED is only reachable by
/// attaching a real cash-service reconciliation/settlement reference that
/// payroll-service verifies exists (see payment-handoff-service.ts).
model PayrollPaymentHandoff {
  id                String    @id @default(cuid())
  tenantId          String    @map("tenant_id")
  legalEntityId     String?   @map("legal_entity_id")
  payrollBatchId    String    @map("payroll_batch_id")
  journalEntryId    String    @map("journal_entry_id")
  clearingGlAccountCode String @map("clearing_gl_account_code")
  totalAmount       Decimal   @db.Decimal(15, 2) @map("total_amount")
  /// NOT_CONFIGURED | PAYMENT_EXPORT_READY | EXTERNAL_TRANSMISSION_PENDING |
  /// CERTIFICATION_PENDING | PAYMENT_IN_PROCESS | SETTLED | FAILED | VOIDED
  status            String    @default("NOT_CONFIGURED")
  /// Deterministic, derived from (tenantId, payrollBatchId) — a retry of the
  /// same batch's handoff creation is a safe no-op, never a duplicate record.
  idempotencyKey    String    @map("idempotency_key")
  /// Real cash-service reconciliation/settlement record id — populated only
  /// after payroll-service verifies it via a live lookup; never accepted
  /// as an unverified client-supplied claim of settlement.
  settlementReference String? @map("settlement_reference")
  failureReason     String?   @map("failure_reason")
  voidedAt          DateTime? @map("voided_at")
  voidReason        String?   @map("void_reason")
  createdBy         String    @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  settledAt         DateTime? @map("settled_at")

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, payrollBatchId])
  @@map("payroll_payment_handoffs")
  @@index([tenantId, legalEntityId])
  @@index([tenantId, status])
}

/// @net-new CE-13/S025 — Payroll+Close GL mapping rule pack, versioned under
/// approved S023-style governance (author != activator, one ACTIVE version
/// per packKey, simulate-before-activate). This is payroll's OWN mapping
/// governance table — it does NOT duplicate coa-service's generic S019/S020
/// posting-engine DSL; it governs which PayrollGLMapping rows are considered
/// the pinned, audited configuration a given run/accrual/commission journal
/// cites (rulePackVersionId on PayrollBatch / AccrualEntry / etc.).
model PayrollRulePackVersion {
  id            String    @id @default(cuid())
  tenantId      String    @map("tenant_id")
  /// @net-new fix(integration): rule-pack activation/selection is now
  /// legal-entity scoped — null only for pre-existing rows awaiting
  /// reconciliation (they may not be activated until backfilled).
  legalEntityId String?   @map("legal_entity_id")
  packKey       String    @map("pack_key")
  version       Int
  status        String    @default("DRAFT") // DRAFT | VALIDATED | ACTIVE | SUPERSEDED
  /// Blank rows are valid (ACCOUNT_MAPPING_VALUES_PENDING) — every row names
  /// family/department/payComponent; glAccountCode may be null pending config.
  rows          Json
  author        String    @map("author")
  activatedBy   String?   @map("activated_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  validatedAt   DateTime? @map("validated_at")
  activatedAt   DateTime? @map("activated_at")
  supersededAt  DateTime? @map("superseded_at")

  @@unique([tenantId, legalEntityId, packKey, version])
  @@map("payroll_rule_pack_version")
  @@index([tenantId, packKey, status])
  @@index([tenantId, legalEntityId, status])
}

/// @net-new CE-13/S110 — Chargeback/clawback consumption. sourceEventId is
/// nullable: CE-12 (S086/S091/S093) event ingestion is
/// PENDING_UPSTREAM_TECHNICAL_RECONCILIATION on this branch (CE-12 is not
/// yet integrated into r1-integration); clawbacks can be entered via the
/// fixture/manual trigger endpoint today, and the same domain logic will
/// consume the real CE-12 event once that integration point lands.
model ClawbackRecord {
  id                       String    @id @default(cuid())
  tenantId                 String    @map("tenant_id")
  legalEntityId            String?   @map("legal_entity_id")
  employeeId               String    @map("employee_id")
  dealId                   String    @map("deal_id")
  originalCommissionRecordId String? @map("original_commission_record_id")
  method                   String    // FULL | PRO_RATA
  clawbackAmount           Decimal   @db.Decimal(15, 2) @map("clawback_amount")
  remainingPayable         Decimal   @default(0) @db.Decimal(15, 2) @map("remaining_payable")
  receivableAmount         Decimal   @default(0) @db.Decimal(15, 2) @map("receivable_amount")
  status                   String    @default("PENDING") // PENDING | NEXT_RUN_DEDUCTION | RECEIVABLE | RECOVERED | REPAID
  journalEntryId            String?  @map("journal_entry_id")
  sourceEventId              String? @map("source_event_id")
  sourceEventType            String? @map("source_event_type")
  createdBy                 String   @map("created_by")
  createdAt                 DateTime @default(now()) @map("created_at")
  resolvedAt                 DateTime? @map("resolved_at")

  @@map("clawback_records")
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, legalEntityId])
  @@unique([tenantId, legalEntityId, dealId, employeeId, method])
}

/// @net-new CE-13/S111 — Period-end compensation accruals, auto-reversing
/// next period (S218-linked reversing entries).
model AccrualEntry {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  legalEntityId       String?   @map("legal_entity_id")
  periodYear          Int       @map("period_year")
  periodMonth         Int       @map("period_month")
  accrualType         String    @map("accrual_type") // WAGES | COMMISSION | PTO | BONUS
  basisDescription    String?   @map("basis_description")
  amount              Decimal   @db.Decimal(15, 2)
  department          String?
  status              String    @default("PREVIEW") // PREVIEW | APPROVED | POSTED | REVERSED
  previewedBy         String?   @map("previewed_by")
  approvedBy          String?   @map("approved_by")
  approvedAt          DateTime? @map("approved_at")
  postedJournalEntryId    String? @map("posted_journal_entry_id")
  reversalJournalEntryId  String? @map("reversal_journal_entry_id")
  autoReverseDate     DateTime? @map("auto_reverse_date")
  reversedAt          DateTime? @map("reversed_at")
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@map("accrual_entries")
  @@index([tenantId, periodYear, periodMonth])
  @@index([tenantId, status])
  @@index([tenantId, legalEntityId])
  @@unique([tenantId, legalEntityId, periodYear, periodMonth, accrualType, department])
}

/// @net-new CE-13/S112 — Tech flag-hour earnings bridge. sourceEventId
/// nullable: CE-11 S063 period-boundary event ingestion is
/// PENDING_UPSTREAM_TECHNICAL_RECONCILIATION (CE-11 not yet integrated into
/// r1-integration); entries can be created via the fixture/manual trigger
/// endpoint today.
model TechFlagBridgeEntry {
  id                  String    @id @default(cuid())
  tenantId            String    @map("tenant_id")
  legalEntityId       String?   @map("legal_entity_id")
  employeeId          String    @map("employee_id")
  periodStart         DateTime  @map("period_start")
  periodEnd           DateTime  @map("period_end")
  flagHours           Decimal   @db.Decimal(8, 2) @map("flag_hours")
  flagRate            Decimal?  @db.Decimal(15, 4) @map("flag_rate")
  guaranteeShortfall  Decimal   @default(0) @db.Decimal(15, 2) @map("guarantee_shortfall")
  earningsAmount      Decimal   @default(0) @db.Decimal(15, 2) @map("earnings_amount")
  guaranteeTopUp      Decimal   @default(0) @db.Decimal(15, 2) @map("guarantee_top_up")
  absorptionAmount    Decimal?  @db.Decimal(15, 2) @map("absorption_amount")
  reconciliationStatus String   @default("PENDING") @map("reconciliation_status") // PENDING | TIED | VARIANCE
  status              String    @default("RATE_GAP") // RATE_GAP | READY | APPLIED
  sourceEventId       String?   @map("source_event_id")
  sourceEventType     String?   @map("source_event_type")
  payrollItemId       String?   @map("payroll_item_id")
  createdBy           String    @map("created_by")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@map("tech_flag_bridge_entries")
  @@index([tenantId, employeeId])
  @@index([tenantId, status])
  @@index([tenantId, legalEntityId])
}

/// @net-new CE-13/S109 — dispute/adjustment ceremony on a posted or accrued
/// commission record. Every adjustment is audited with a reason and linked
/// back to the original CommissionRecord.
model CommissionDispute {
  id                    String    @id @default(cuid())
  tenantId              String    @map("tenant_id")
  legalEntityId         String?   @map("legal_entity_id")
  commissionRecordId    String    @map("commission_record_id")
  reason                String
  originalAmount        Decimal   @db.Decimal(15, 2) @map("original_amount")
  adjustedAmount        Decimal   @db.Decimal(15, 2) @map("adjusted_amount")
  status                String    @default("OPEN") // OPEN | RESOLVED
  raisedBy              String    @map("raised_by")
  resolvedBy            String?   @map("resolved_by")
  resolvedAt            DateTime? @map("resolved_at")
  createdAt             DateTime  @default(now()) @map("created_at")

  @@map("commission_disputes")
  @@index([tenantId, commissionRecordId])
  @@index([tenantId, legalEntityId])
}

/// @net-new CE-13/security — audit row for every read of an individual
/// employee's compensation detail (masking standing rule).
model PayrollSensitiveReadAudit {
  id          String   @id @default(cuid())
  tenantId    String   @map("tenant_id")
  legalEntityId String? @map("legal_entity_id")
  employeeId  String   @map("employee_id")
  readByUserId String  @map("read_by_user_id")
  readByRole  String?  @map("read_by_role")
  surface     String   // e.g. 'employee-detail', 'payroll-register', 'ytd-inquiry'
  readAt      DateTime @default(now()) @map("read_at")

  @@map("payroll_sensitive_read_audit")
  @@index([tenantId, employeeId])
  @@index([tenantId, readAt])
}

model PayrollGLMapping {
  id            String  @id @default(cuid())
  tenantId      String  @map("tenant_id")
  legalEntityId String? @map("legal_entity_id")
  department    String
  payComponent  String  @map("pay_component")
  glAccountCode String  @map("gl_account_code")
  isDebit       Boolean @map("is_debit")

  @@unique([tenantId, legalEntityId, department, payComponent])
  @@map("payroll_gl_mappings")
  @@index([tenantId])
  @@index([tenantId, legalEntityId])
}

model PayrollTaxRate {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  taxType       String   @map("tax_type")
  rate          Decimal  @db.Decimal(7, 6)
  wageBase      Decimal? @map("wage_base") @db.Decimal(15, 2)
  effectiveYear Int      @map("effective_year")
  isEmployer    Boolean  @default(false) @map("is_employer")

  @@unique([tenantId, taxType, effectiveYear, isEmployer])
  @@map("payroll_tax_rates")
  @@index([tenantId, effectiveYear])
}

model EmployeeYTD {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  legalEntityId   String?  @map("legal_entity_id")
  employeeId      String   @map("employee_id")
  employee        Employee @relation(fields: [employeeId], references: [id])
  year            Int
  grossPay        Decimal  @default(0) @map("gross_pay")        @db.Decimal(15, 2)
  federalTax      Decimal  @default(0) @map("federal_tax")      @db.Decimal(15, 2)
  stateTax        Decimal  @default(0) @map("state_tax")        @db.Decimal(15, 2)
  socialSecurity  Decimal  @default(0) @map("social_security")  @db.Decimal(15, 2)
  medicare        Decimal  @default(0) @map("medicare")         @db.Decimal(15, 2)
  ficaWages       Decimal  @default(0) @map("fica_wages")       @db.Decimal(15, 2)
  otherDeductions Decimal  @default(0) @map("other_deductions") @db.Decimal(15, 2)
  netPay          Decimal  @default(0) @map("net_pay")          @db.Decimal(15, 2)

  @@unique([tenantId, employeeId, year])
  @@map("employee_ytd")
  @@index([tenantId, year])
  @@index([tenantId, legalEntityId])
}

model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String    @map("event_type")
  tenantId      String    @map("tenant_id")
  payload       Json
  correlationId String?   @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  retryCount    Int       @default(0) @map("retry_count")
  lastError     String?   @map("last_error")

  @@map("outbox_events")
  @@index([publishedAt, retryCount])
  @@index([createdAt])
}

/// @net-new Phase 1: Commission plans for employees
model CommissionPlan {
  id               String   @id @default(cuid())
  tenantId         String   @map("tenant_id")
  legalEntityId    String?  @map("legal_entity_id")
  employeeId       String   @map("employee_id")
  planType         String   @db.VarChar(20) @map("plan_type")
  department       String?
  flatAmount       Decimal? @db.Decimal(15, 2) @map("flat_amount")
  percentageRate   Decimal? @db.Decimal(5, 2) @map("percentage_rate")
  tiers            Json?
  effectiveDate    DateTime @db.Date @map("effective_date")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  /// @net-new CE-13/S109 — split rules across multiple employees on one
  /// deal (e.g. [{employeeId, sharePct}]), draw configuration (advance
  /// against future commission), and minimum-guarantee floor.
  splitRules       Json?    @map("split_rules")
  drawAmount       Decimal? @db.Decimal(15, 2) @map("draw_amount")
  minimumGuarantee Decimal? @db.Decimal(15, 2) @map("minimum_guarantee")
  chargebackTerms  Json?    @map("chargeback_terms") // { method: 'FULL'|'PRO_RATA', floor?: number }
  supersededBy     String?  @map("superseded_by")
  version          Int      @default(1)

  records          CommissionRecord[]

  @@map("commission_plans")
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, isActive])
  @@index([tenantId, legalEntityId])
}

/// @net-new Phase 1: Commission records per deal
model CommissionRecord {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  legalEntityId   String?  @map("legal_entity_id")
  employeeId      String   @map("employee_id")
  dealId          String?  @map("deal_id")
  dealType        String?  @db.VarChar(20) @map("deal_type")
  grossProfit     Decimal  @db.Decimal(15, 2) @map("gross_profit")
  commissionAmount Decimal  @db.Decimal(15, 2) @map("commission_amount")
  planId          String?  @map("plan_id")
  status          String   @default("ACCRUED")
  journalEntryId  String?  @map("journal_entry_id")
  /// @net-new fix(integration): the payroll batch this commission record was
  /// paid through — set when the record is attached to a batch item, never
  /// user-supplied. journalEntryId above is populated automatically from
  /// this batch's own PAYROLL_BATCH_POSTED posting result once POSTED
  /// (commission-service.ts's linkPostedBatch), replacing the old
  /// disconnected manual markPaid(journalEntryId) call.
  payrollBatchId  String?  @map("payroll_batch_id")
  /// Reversing journal id when the source batch is voided — set alongside
  /// status=REVERSED, never overwrites journalEntryId (the original
  /// journal's identity is preserved for audit).
  reversalJournalEntryId String? @map("reversal_journal_entry_id")
  periodYear      Int?     @map("period_year")
  periodMonth     Int?     @map("period_month")
  createdAt       DateTime @default(now()) @map("created_at")
  createdBy       String?  @map("created_by")

  /// @net-new CE-13/S109 — deal-level trace evidence + draw/clawback linkage.
  dealSnapshotRef String?  @map("deal_snapshot_ref") // CE-12 S084 snapshot reference (PUTR until CE-12 integrates)
  appliedToDraw   Boolean  @default(false) @map("applied_to_draw")
  splitEmployeeId String?  @map("split_employee_id") // when this row is one leg of a split
  clawedBackAmount Decimal @default(0) @db.Decimal(15, 2) @map("clawed_back_amount")

  plan            CommissionPlan? @relation(fields: [planId], references: [id])

  @@map("commission_records")
  @@index([tenantId])
  @@index([tenantId, employeeId])
  @@index([tenantId, periodYear, periodMonth])
  @@index([tenantId, status])
  @@index([tenantId, legalEntityId])
  @@index([tenantId, payrollBatchId])
}
