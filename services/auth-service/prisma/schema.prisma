generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/auth-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ApiKey {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  keyHash   String   @map("key_hash")
  name      String
  scopes    String[] @default(["read", "write"])
  isActive  Boolean  @default(true) @map("is_active")
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("api_keys")
  @@index([keyHash])
  @@index([tenantId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  tenantId  String   @map("tenant_id")
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("refresh_tokens")
  @@index([tenantId])
}

// ── S207: Permission Catalog & Check API ───────────────────────────────────────
// Versioned, deny-by-default authorization. Catalog ships with releases (BR207-1):
// no runtime-added permissions. Scope model tenant->entity->store (BR207-4).

/// Master list of every action the system allows. One row per permission key.
model Permission {
  key          String   @id                      // dot-namespaced, e.g. "je.post"
  description  String
  sinceVersion String   @map("since_version")    // catalog version the key shipped in
  status       String   @default("SHIPPED")      // DRAFT | SHIPPED | DEPRECATED
  createdAt    DateTime @default(now()) @map("created_at")

  rolePermissions RolePermission[]

  @@map("permission")
  @@index([status])
}

/// Grants a permission key to a role. Seeded with releases (S206 later manages).
model RolePermission {
  role          String
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at")

  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@id([role, permissionKey])
  @@map("role_permission")
  @@index([permissionKey])
}

/// Read-model projection of who holds which role, in which scope. Populated by
/// S206 `iam.assignment.*` events (cache invalidation). S207 exposes NO CRUD here
/// — assignment MANAGEMENT is S206. Seeded minimally so checks are demonstrable.
model AuthzRoleAssignment {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      String
  entityId  String?  @map("entity_id")
  storeId   String?  @map("store_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([tenantId, userId, role, entityId, storeId], name: "authz_assignment_unique")
  @@map("authz_role_assignment")
  @@index([tenantId, userId])
}

/// Catalog version metadata. Enables the GET /authz/catalog diff report (AC).
model CatalogVersion {
  version     String   @id                        // e.g. "1.0.0"
  releasedAt  DateTime @default(now()) @map("released_at")
  description String?

  @@map("catalog_version")
}

/// Transactional outbox for iam.authz.denied events (mirrors tenant_outbox_events).
model AuthzOutboxEvent {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  eventType   String    @map("event_type")
  aggregateId String    @map("aggregate_id")
  payload     Json
  publishedAt DateTime? @map("published_at")
  retryCount  Int       @default(0) @map("retry_count")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, retryCount])
  @@map("authz_outbox_events")
}

// ── S206: Basic Role Management ────────────────────────────────────────────────
// Roles are named permission sets (BR206-1); access is granted only by auditable,
// store-scoped role assignment (BR206-3). Never by individual permission grant.

/// A named set of catalog permission keys. `key` is the stable slug projected into
/// role_permission / authz_role_assignment (the S207 read models). Starter roles
/// (BR206-4) ship builtIn = true. Name is unique per tenant (1–60 chars).
model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  key         String                                  // stable slug, e.g. ADMIN
  name        String                                  // display name, 1–60
  permissions String[] @default([])                   // catalog permission keys (BR206-1)
  builtIn     Boolean  @default(false) @map("built_in")
  status      String   @default("ACTIVE")             // ACTIVE | RETIRED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  assignments RoleAssignment[]

  @@unique([tenantId, name], name: "role_name_per_tenant")
  @@unique([tenantId, key], name: "role_key_per_tenant")
  @@map("role")
  @@index([tenantId])
}

/// Grant of a role to a user, scoped to a legal entity and either ALL stores in
/// that entity (allStores = true) or a specific set (storeIds). Deletion of an
/// assigned role is blocked (BR206-2); revocation flips status to REVOKED.
model RoleAssignment {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  roleId    String    @map("role_id")
  entityId  String?   @map("entity_id")            // null = tenant-wide (platform/tenant admin)
  storeIds  String[]  @default([]) @map("store_ids")  // empty when allStores = true
  allStores Boolean   @default(false) @map("all_stores")
  status    String    @default("GRANTED")             // GRANTED | REVOKED
  createdAt DateTime  @default(now()) @map("created_at")
  revokedAt DateTime? @map("revoked_at")

  role Role @relation(fields: [roleId], references: [id])

  @@map("role_assignment")
  @@index([tenantId, userId])
  @@index([roleId])
}

// ── S004A: Dealership Position Role Templates ─────────────────────────────────
// Shipped, position-shaped starter permission sets (BILLER, CASHIER, TITLE_CLERK,
// AP_CLERK, AR_CLERK, ACCOUNTANT, OFFICE_MGR, CONTROLLER, SALESPERSON_RO) that a
// security administrator applies in one click instead of hand-building a role.
// Applying a template does NOT create a parallel permission map: it materializes
// (or reuses) a real, tenant-scoped S206 `Role` keyed by the template's position
// and grants it via the real S206/S207 `RoleAssignment` mechanism, so the exact
// same AuthzService.check() enforcement already proven for S206 governs it.

/// `tenantId = NULL` rows are the global, shipped defaults (BR4A-1) — visible to
/// every tenant (RLS SELECT policy), never mutable by any tenant (RLS INSERT/
/// UPDATE/DELETE require a real tenantId). A tenant "customizes" a shipped
/// template by cloning it (`clonedFromId` set) into its own tenantId-owned row;
/// the clone is copied by value, so editing the shipped source afterward never
/// retroactively mutates an already-created clone (BR4A-1 exception workflow).
model RoleTemplate {
  id            String    @id @default(uuid())
  tenantId      String?   @map("tenant_id")             // null = global shipped default
  key           String                                  // position slug, e.g. BILLER
  name          String                                  // display name, 1–60
  permissions   String[]  @default([])                  // catalog permission keys (no local map)
  fieldMasks    String[]  @default([]) @map("field_masks") // e.g. ["vehicle.cost"] (BR4A-2)
  builtIn       Boolean   @default(false) @map("built_in")
  status        String    @default("ACTIVE")            // ACTIVE | INACTIVE
  clonedFromId  String?   @map("cloned_from_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  assignments RoleTemplateAssignment[]

  @@map("role_template")
  @@index([tenantId])
  @@index([key])
}

/// Record of a template being applied to a user. Backed 1:1 by a real S206
/// `RoleAssignment` (roleAssignmentId) — this table exists only so a template
/// application (and its later deactivation) can be looked up and reversed by
/// template identity, never as an independent enforcement path.
model RoleTemplateAssignment {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  templateId       String    @map("template_id")
  userId           String    @map("user_id")
  roleAssignmentId String    @map("role_assignment_id")
  entityId         String?   @map("entity_id")
  storeIds         String[]  @default([]) @map("store_ids")
  allStores        Boolean   @default(false) @map("all_stores")
  status           String    @default("APPLIED")        // APPLIED | REVOKED
  createdAt        DateTime  @default(now()) @map("created_at")
  revokedAt        DateTime? @map("revoked_at")

  template RoleTemplate @relation(fields: [templateId], references: [id])

  @@map("role_template_assignment")
  @@index([tenantId, userId])
  @@index([templateId])
}

/// AuditPort stub outbox (S007 dependency). Every state change writes a record with
/// before/after images; the real audit service consumes this table when S007 merges.
model AuditOutboxEvent {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  docType     String    @map("doc_type")
  docId       String    @map("doc_id")
  action      String
  before      Json?
  after       Json?
  actor       String
  publishedAt DateTime? @map("published_at")
  retryCount  Int       @default(0) @map("retry_count")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, retryCount])
  @@map("audit_outbox")
}

// ── S205: User Account Lifecycle ────────────────────────────────────────────────
// Security admins create, deactivate, unlock and reset users with entity/store scope
// so only current staff hold access. Users hold NO permissions directly (BR205-4) —
// authorization comes solely from S206 role assignments. Every state change emits a
// §9 event and an AuditPort record (§11). Deactivation revokes sessions (BR205-2) and
// emits iam.user.deactivated, which S206 consumes to auto-revoke that user's roles.

/// A staff login. Email is unique per tenant (BR205-1). Status transitions:
/// INVITED → ACTIVE → LOCKED (5 failed logins) → ACTIVE (admin unlock);
/// ACTIVE → INACTIVE (deactivate; sessions revoked). Users carry entity/store scope
/// but no direct permissions.
model User {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  email        String
  displayName  String    @map("display_name")            // 1–80
  status       String    @default("INVITED")             // INVITED | ACTIVE | LOCKED | INACTIVE
  failedLogins Int       @default(0) @map("failed_logins")
  entityScope  String[]  @default([]) @map("entity_scope")
  storeScope   String[]  @default([]) @map("store_scope")
  version      Int       @default(0)
  passwordHash        String?   @map("password_hash")          // set via first activation / reset (S205 login)
  resetTokenHash      String?   @map("reset_token_hash")
  resetTokenExpiresAt DateTime? @map("reset_token_expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deactivatedAt DateTime? @map("deactivated_at")

  sessions Session[]

  @@unique([tenantId, email], name: "user_email_per_tenant")
  @@map("user")
  @@index([tenantId])
}

/// An issued session. Deactivation flips every ACTIVE session to REVOKED within the
/// SLA (BR205-2), which is how "leaver access is closed" is proven by a timed test.
model Session {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  status    String    @default("ACTIVE")                 // ACTIVE | REVOKED
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id])

  @@map("session")
  @@index([tenantId, userId])
  @@index([status])
}
