generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/posting-recovery-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// S021 — Posting Recovery (DLQ inspection workbench), first slice.
///
/// This is the tenant-owned case record for one failed accounting-posting
/// event received from CH01 (the posting evaluator) via
/// PostingFailureIntakePort. Everything under "original event" below is
/// immutable after intake (DB trigger `posting_dead_letter_immutability`
/// enforces this — see the accompanying migration): sourceEventId,
/// correlationId, causationId, originalEventTimestamp,
/// postingIdempotencyKey, payload, payloadHash. This slice is read-only:
/// no route in this service ever posts to GL, replays, or edits these
/// fields; status/assignedOwner/version exist only as the foundation for a
/// future command slice.
model PostingDeadLetter {
  id       String  @id @default(uuid())
  tenantId String  @map("tenant_id")
  /// Dealer/legal-entity scope (tenant-service LegalEntity.id), when the
  /// source event carried one. Nullable — some source events are
  /// tenant-level only (e.g. platform-level rule configuration failures).
  legalEntityId String? @map("legal_entity_id")
  storeId       String? @map("store_id")

  /// CH01 SourceEventEnvelope.eventId. Immutable. Idempotency identity is
  /// (tenantId, sourceEventId) — see @@unique below.
  sourceEventId    String @map("source_event_id")
  sourceEventType  String @map("source_event_type")
  /// CH01 SourceEventEnvelope.eventSchemaVersion. Immutable. Required to
  /// reconstruct a byte-identical replay envelope (CH01 rule-pack version
  /// selection filters on it) — S021 completion slice; nullable at the DB
  /// level only to tolerate pre-existing fixture rows, always populated by
  /// DeadLetterIntakeService going forward.
  eventSchemaVersion String? @map("event_schema_version")
  sourceSystem     String @map("source_system")
  sourceEntityType String? @map("source_entity_type")
  /// CH01 SourceEventEnvelope.sourceEntityId. Immutable. S021 completion
  /// slice — required for replay envelope reconstruction (distinct from
  /// sourceTransactionId, which is display-only).
  sourceEntityId String? @map("source_entity_id")
  /// The originating business transaction (RO#, deal#, invoice#, etc).
  sourceTransactionId String? @map("source_transaction_id")

  /// Immutable. CH01 SourceEventEnvelope.correlationId.
  correlationId String  @map("correlation_id")
  causationId   String? @map("causation_id")

  /// Immutable. The original event's occurredAt — never the intake/failure time.
  originalEventTimestamp DateTime  @map("original_event_timestamp")
  /// CH01 SourceEventEnvelope.publishedAt. Immutable. Excluded from CH01's
  /// identity hash, but still captured verbatim for lineage — S021
  /// completion slice.
  originalEventPublishedAt DateTime? @map("original_event_published_at")
  businessDate           DateTime? @map("business_date") @db.Date

  /// Immutable. The posting idempotency identity CH01 would have used to
  /// post this event (BR S020-6-style key) — never regenerated by recovery.
  postingIdempotencyKey String @map("posting_idempotency_key")

  /// Immutable. The original event payload, verbatim, plus its hash.
  payload     Json
  payloadHash String @map("payload_hash")

  /// True when the payload contains fields that must be masked unless the
  /// caller holds posting-recovery.payload.read-sensitive.
  containsSensitiveData Boolean @default(false) @map("contains_sensitive_data")

  /// QUARANTINED | UNDER_REVIEW | AWAITING_CORRECTION | READY_FOR_REPLAY |
  /// REPLAY_IN_PROGRESS | RESOLVED | ESCALATED | DISPOSITIONED
  status String @default("QUARANTINED")

  /// Immutable. Set once, at intake.
  firstFailureAt        DateTime @map("first_failure_at")
  latestFailureAt       DateTime @map("latest_failure_at")
  latestFailureCategory String   @map("latest_failure_category")
  latestFailureCode     String   @map("latest_failure_code")
  /// Denormalized from the latest PostingDeadLetterFailure row, so the queue
  /// list can show a failure summary without an N+1 join per row.
  latestFailureMessage  String   @map("latest_failure_message")

  attemptCount    Int       @default(0) @map("attempt_count")
  /// Denormalized from the latest PostingReplayAttempt row (fixture-created
  /// in this slice — no production replay exists yet) for queue display.
  lastAttemptAt   DateTime? @map("last_attempt_at")
  assignedOwner   String?   @map("assigned_owner")
  escalationState String? @map("escalation_state")

  /// Only populated once a real journal exists for this source event
  /// (never written by this slice — foundation for a future replay slice).
  journalReference String? @map("journal_reference")

  /// Optimistic-concurrency lock used by ReplayService's atomic CAS
  /// (READY_FOR_REPLAY -> REPLAY_IN_PROGRESS) and by ReplayReaperService's
  /// stale-lock reclaim (REPLAY_IN_PROGRESS -> AWAITING_CORRECTION).
  version Int @default(1)

  /// CE-07 integration — set only while status = REPLAY_IN_PROGRESS; cleared
  /// (null) the moment the case leaves that status, whether by a completed
  /// replay or by ReplayReaperService reclaiming a stale lock. Lets the
  /// reaper find "stuck since a crash" cases without a separate lock table.
  replayLockAcquiredAt DateTime? @map("replay_lock_acquired_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  failures      PostingDeadLetterFailure[]
  attempts      PostingReplayAttempt[]
  corrections   PostingCorrectionRevision[]
  transitions   PostingCaseTransition[]
  assignments   PostingCaseAssignment[]
  auditRefs     PostingRecoveryAuditReference[]

  @@unique([tenantId, sourceEventId])
  @@index([tenantId, status])
  @@index([tenantId, correlationId])
  @@index([tenantId, sourceTransactionId])
  @@index([tenantId, latestFailureCategory])
  @@index([tenantId, firstFailureAt])
  @@index([tenantId, assignedOwner])
  @@index([status, replayLockAcquiredAt])
  @@map("posting_dead_letter")
}

/// Append-only. One row per failure observation for a case — the first
/// intake failure, plus one additional row per subsequent replay/validation
/// failure. Never updated or deleted (DB trigger enforced).
model PostingDeadLetterFailure {
  id           String @id @default(uuid())
  tenantId     String @map("tenant_id")
  deadLetterId String @map("dead_letter_id")

  /// Stable taxonomy category (see PostingFailureCategory).
  failureCategory String @map("failure_category")
  /// Stable failure code — separate from category, e.g.
  /// "RULE_PACK_NOT_FOUND_FOR_SOURCE_EVENT_TYPE".
  failureCode    String  @map("failure_code")
  /// CONTRACT_VALIDATION | RULE_RESOLUTION | MAPPING | PERIOD_CHECK |
  /// DOWNSTREAM_POST | UNKNOWN
  failureStage   String  @map("failure_stage")
  failureMessage String  @map("failure_message")
  /// Field-level validation detail, when available (e.g. contract violations).
  fieldErrors Json? @map("field_errors")
  /// CH01 rule context, when available (rule pack id/version, matched rule).
  ruleContext Json? @map("rule_context")

  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  deadLetter PostingDeadLetter @relation(fields: [deadLetterId], references: [id])

  @@index([tenantId, deadLetterId])
  @@index([tenantId, failureCategory])
  @@map("posting_dead_letter_failure")
}

/// Append-only replay-attempt history. Real replay execution is explicitly
/// out of scope for this slice — rows are created only via the test/
/// fixture intake mechanism to prove the read model. Never updated or
/// deleted.
model PostingReplayAttempt {
  id            String @id @default(uuid())
  tenantId      String @map("tenant_id")
  deadLetterId  String @map("dead_letter_id")
  attemptNumber Int    @map("attempt_number")

  /// REQUESTED | AUTHORIZED | STARTED | SUCCEEDED | FAILED |
  /// NOOP_ALREADY_POSTED | REJECTED | TIMED_OUT
  status String

  requestedBy String   @map("requested_by")
  requestedAt DateTime @map("requested_at")
  authorizedBy String? @map("authorized_by")
  authorizedAt DateTime? @map("authorized_at")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  resultMessage String? @map("result_message")
  /// Only set when a journal reference already exists for this attempt.
  resultingJournalReference String? @map("resulting_journal_reference")

  createdAt DateTime @default(now()) @map("created_at")

  deadLetter PostingDeadLetter @relation(fields: [deadLetterId], references: [id])

  @@unique([deadLetterId, attemptNumber])
  @@index([tenantId, deadLetterId])
  @@map("posting_replay_attempt")
}

/// Append-only correction-history read model. No correction-authoring
/// workflow exists in this slice; rows exist only to prove the read
/// contract (populated via fixtures).
model PostingCorrectionRevision {
  id             String @id @default(uuid())
  tenantId       String @map("tenant_id")
  deadLetterId   String @map("dead_letter_id")
  revisionNumber Int    @map("revision_number")

  /// FIELD_CORRECTION | MAPPING_OVERRIDE | REFERENCE_DATA_FIX | OTHER
  correctionType  String  @map("correction_type")
  description     String
  proposedChanges Json?   @map("proposed_changes")
  /// PROPOSED | APPROVED | REJECTED | APPLIED
  status          String  @default("PROPOSED")

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  deadLetter PostingDeadLetter @relation(fields: [deadLetterId], references: [id])

  @@unique([deadLetterId, revisionNumber])
  @@index([tenantId, deadLetterId])
  @@map("posting_correction_revision")
}

/// Append-only lifecycle-transition history. Never updated or deleted.
model PostingCaseTransition {
  id           String  @id @default(uuid())
  tenantId     String  @map("tenant_id")
  deadLetterId String  @map("dead_letter_id")
  fromStatus   String? @map("from_status")
  toStatus     String  @map("to_status")
  reason       String?
  actor        String
  occurredAt   DateTime @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")

  deadLetter PostingDeadLetter @relation(fields: [deadLetterId], references: [id])

  @@index([tenantId, deadLetterId])
  @@map("posting_case_transition")
}

/// Append-only ownership-assignment history. The current owner is the
/// latest row for a case (also denormalized onto
/// PostingDeadLetter.assignedOwner for queue filtering).
model PostingCaseAssignment {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  deadLetterId String   @map("dead_letter_id")
  assignedTo   String?  @map("assigned_to")
  assignedBy   String   @map("assigned_by")
  assignedAt   DateTime @map("assigned_at")
  note         String?
  createdAt    DateTime @default(now()) @map("created_at")

  deadLetter PostingDeadLetter @relation(fields: [deadLetterId], references: [id])

  @@index([tenantId, deadLetterId])
  @@map("posting_case_assignment")
}

/// This service's audit outbox (named per the S021 story's required table
/// list). Drained by the shared @amacc/shared-kernel AuditOutboxDrainer to
/// audit-service, exactly like every other service's audit_outbox — see
/// services/gl-service/prisma/schema.prisma's OutboxEvent /
/// services/tenant-service/prisma/schema.prisma's AuditOutboxEvent.
/// Excluded from RLS (background drainer runs outside tenant request
/// context) — see the RLS migration.
model PostingRecoveryAuditReference {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  deadLetterId String?   @map("dead_letter_id")
  eventType    String    @map("event_type")
  actor        String
  before       Json?
  after        Json?
  publishedAt  DateTime? @map("published_at")
  retryCount   Int       @default(0) @map("retry_count")
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at")

  deadLetter PostingDeadLetter? @relation(fields: [deadLetterId], references: [id])

  @@index([publishedAt, retryCount])
  @@index([tenantId, deadLetterId])
  @@map("posting_recovery_audit_reference")
}
