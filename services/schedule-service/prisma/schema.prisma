// @trace-cobol schedup.cbl (schedule master), komdetail.cbl (detail CRUD),
//              schedsec.cbl (permissions), schedmgr.cbl (GL linkage)
// @wave Wave 3 — Schedule Sub-System

generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/schedule-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// @trace-cobol sched.rec — SCHEDULE-REC (60 bytes)
// SD-SCHDNO(2), SD-TITLE(29), SD-RPT-SEQ(1), SD-TYPE(1),
// SD-GLACCTNO[5](25), SD-EOM-PURGE(1), SD-CONT-NAMES(1)
model Schedule {
  id                 String   @id @default(cuid())
  tenantId           String   @map("tenant_id")
  // SD-SCHDNO: 2-digit right-justified numeric string e.g. "01", "99"
  scheduleNumber     String   @db.Char(2) @map("schedule_number")
  // SD-TITLE: up to 29 chars
  title              String   @db.VarChar(29)
  // SD-RPT-SEQ: C=control#, N=name, A=age
  reportSequence     String   @default("C") @db.Char(1) @map("report_sequence")
  // SD-TYPE: 1–5 — drives key structure of detail records
  scheduleType       Int      @map("schedule_type")
  // SD-GLACCTNO[1..5]: up to 5 GL account numbers (5-char each)
  // Types 2,4,5 allow only ONE account; types 1,3 allow up to 5
  glAccountNumbers   String[] @map("gl_account_numbers")
  // SD-EOM-PURGE: 1–7 — EOM purge algorithm code
  eomPurgeType       Int      @map("eom_purge_type")
  // SD-CONT-NAMES: Y/2/D/V/blank — control name display flag
  controlNameDisplay String   @default(" ") @db.Char(1) @map("control_name_display")

  details     ScheduleDetail[]
  permissions SchedulePermission[]

  @@unique([tenantId, scheduleNumber])
  @@map("schedules")
  @@index([tenantId])
}

// @trace-cobol detail.fc/fd — DETAIL-MF ISAM file
// Primary key: DE-KEY (type-dependent composite)
// Alternate key: DE-CONTNO (with duplicates)
// Data: DE-AMOUNT(S9(9)V99 COMP-3), DE-REFNO, DE-SOURCE, DE-DATE1, DE-ACCTNO, DE-DESC
// Balance-forward variant: DE-BAL-CUR/OVR30/OVR60/OVR90
model ScheduleDetail {
  id             String    @id @default(cuid())
  tenantId       String    @map("tenant_id")
  // DE-SCHDNO: FK to Schedule
  scheduleNumber String    @db.Char(2) @map("schedule_number")
  // DE-CONTNO: 10-char control number (alternate key in ISAM)
  controlNumber  String    @db.VarChar(10) @map("control_number")
  // DE-AMOUNT: S9(9)V99 COMP-3 — monetary
  amount         Decimal   @db.Decimal(15, 2)
  // DE-REFNO: PIC X(12)
  referenceNumber String?  @db.VarChar(12) @map("reference_number")
  // DE-SOURCE: PIC XX — 2-char journal source code
  journalSource  String?   @db.Char(2) @map("journal_source")
  // DE-DATE1: YYYYMMDD
  transactionDate DateTime? @map("transaction_date")
  // DE-ACCTNO: PIC X(20) — which of the schedule's GLs this line belongs to
  glAccountNumber String?  @db.VarChar(20) @map("gl_account_number")
  // DE-DESC: PIC X(35)
  description    String?   @db.VarChar(35)

  // Balance-forward fields (DE-BAL-CUR/OVR30/OVR60/OVR90)
  // Present only when isBalanceForward = true
  // @trace-cobol komdetail.cbl INSERT logic — bal-fwd detected by numeric aging fields
  isBalanceForward Boolean  @default(false) @map("is_balance_forward")
  balanceCurrent   Decimal? @db.Decimal(15, 2) @map("balance_current")
  balanceOver30    Decimal? @db.Decimal(15, 2) @map("balance_over_30")
  balanceOver60    Decimal? @db.Decimal(15, 2) @map("balance_over_60")
  balanceOver90    Decimal? @db.Decimal(15, 2) @map("balance_over_90")

  // Type 5 fields: DE-APPLYNO(X12), DE-APPLY-CD(X)
  // apply-cd: '#' = regular detail, '!' = balance-forward
  applyNumber    String?   @db.VarChar(12) @map("apply_number")
  applyCd        String?   @db.Char(1) @map("apply_cd")

  // Source journal entry (populated from JOURNAL_ENTRY_POSTED event)
  journalEntryId String?   @map("journal_entry_id")
  // @wave S026 — per-line idempotency key (outbox event correlationId). Replaces the
  // old journalEntryId-only dedup, which silently dropped a second schedule-relevant
  // line on the same journal entry. Nullable: manually-created details (POST
  // /details) have no source event.
  sourceCorrelationId String? @map("source_correlation_id")

  createdAt      DateTime  @default(now()) @map("created_at")

  schedule Schedule @relation(fields: [tenantId, scheduleNumber], references: [tenantId, scheduleNumber])

  @@unique([tenantId, sourceCorrelationId])
  @@map("schedule_details")
  @@index([tenantId, scheduleNumber])
  @@index([tenantId, scheduleNumber, controlNumber])
  @@index([tenantId, scheduleNumber, glAccountNumber])
  @@index([tenantId, journalEntryId])
}

// @trace-cobol schedsec.cbl — per-user, per-schedule access control
// COBOL: TABLES-FILE key "SS" + "##" + LOGIN-ID(14) + SEQNO(1)
// COBOL: TB-SS-ACCESS array of 970 entries (index = schedule#, value = Y/N)
// Normalized here: one row per (tenantId, userId, scheduleNumber)
model SchedulePermission {
  id             String  @id @default(cuid())
  tenantId       String  @map("tenant_id")
  userId         String  @map("user_id")
  // 2-digit schedule number, matching Schedule.scheduleNumber
  scheduleNumber String  @db.Char(2) @map("schedule_number")
  canAccess      Boolean @default(false) @map("can_access")

  schedule Schedule @relation(fields: [tenantId, scheduleNumber], references: [tenantId, scheduleNumber])

  @@unique([tenantId, userId, scheduleNumber])
  @@map("schedule_permissions")
  @@index([tenantId, userId])
  @@index([tenantId, scheduleNumber])
}

// @trace-cobol komdetail.cbl DE-APPLYNO/DE-APPLY-CD generalized into a real
// open-item balance ledger. @wave S026 — Schedule Open-Item Core.
// schedule_key = (tenantId, scheduleNumber, controlNumber) — UQ-18 interim resolution
// (docs/accounting-modernization/S026_S027_IMPLEMENTATION_CONTRACT.md).
// Open-item identity = schedule_key + itemNumber (referenceNumber, falling back to
// journalEntryId). A posted line with no applyNumber opens a new item; a line whose
// applyNumber matches an existing item's itemNumber applies against it.
model ScheduleOpenItem {
  id             String  @id @default(cuid())
  tenantId       String  @map("tenant_id")
  scheduleNumber String  @db.Char(2) @map("schedule_number")
  controlNumber  String  @db.VarChar(10) @map("control_number")
  // Targetable business reference a later application's applyNumber must match.
  itemNumber     String  @db.VarChar(20) @map("item_number")
  glAccountNumber String? @db.VarChar(20) @map("gl_account_number")
  journalSource  String? @db.Char(2) @map("journal_source")

  originalAmount   Decimal @db.Decimal(15, 2) @map("original_amount")
  appliedAmount    Decimal @default(0) @db.Decimal(15, 2) @map("applied_amount")
  // Denormalized (= originalAmount - appliedAmount) for query speed; DB CHECK
  // constraint (migration 20260730010000) enforces it stays sign/magnitude-consistent
  // with originalAmount — over-application protection at the storage layer, not just
  // in application code.
  remainingBalance Decimal @db.Decimal(15, 2) @map("remaining_balance")
  // OPEN | PARTIALLY_APPLIED | CLOSED
  status           String  @default("OPEN")

  transactionDate DateTime? @map("transaction_date")
  // Drives S027 aging; falls back to transactionDate when null.
  dueDate         DateTime? @map("due_date")
  description     String?   @db.VarChar(200)

  // Traceability back to the originating posted transaction.
  journalEntryId      String @map("journal_entry_id")
  scheduleDetailId    String? @map("schedule_detail_id")
  // Idempotency key: the outbox event's correlationId for the specific posted line
  // that created this item (gl-service.ts: `${entryCorrelationId}-line-${lineNumber}`).
  sourceCorrelationId String @map("source_correlation_id")

  closedAt  DateTime? @map("closed_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  applications ScheduleApplication[]

  @@unique([tenantId, sourceCorrelationId])
  @@map("schedule_open_items")
  @@index([tenantId, scheduleNumber, controlNumber, itemNumber])
  @@index([tenantId, scheduleNumber, status])
  @@index([tenantId, glAccountNumber])
  @@index([tenantId, dueDate])
}

// One row per application of a settling transaction (or manual operator action)
// against a ScheduleOpenItem. Append-only — a reversal is a new negating row, never
// a mutation of the original (matches komdetail's "amount immutable once posted"
// convention and this repo's APPayment void-by-new-row pattern).
model ScheduleApplication {
  id             String  @id @default(cuid())
  tenantId       String  @map("tenant_id")
  openItemId     String  @map("open_item_id")
  scheduleNumber String  @db.Char(2) @map("schedule_number")
  controlNumber  String  @db.VarChar(10) @map("control_number")
  // Positive = reduces the open item's remaining balance toward zero (same sign
  // convention as originalAmount); a reversal posts the negated amount.
  amount         Decimal @db.Decimal(15, 2)

  journalEntryId      String  @map("journal_entry_id")
  // Idempotency key — see ScheduleOpenItem.sourceCorrelationId. For manual
  // (operator-initiated) applications, this is the caller-supplied idempotency key.
  sourceCorrelationId String  @map("source_correlation_id")
  isManual            Boolean @default(false) @map("is_manual")
  appliedBy           String? @map("applied_by")
  note                String? @db.VarChar(500)

  appliedAt    DateTime  @default(now()) @map("applied_at")
  reversedAt   DateTime? @map("reversed_at")
  reversalOfId String?   @map("reversal_of_id")

  openItem ScheduleOpenItem @relation(fields: [openItemId], references: [id])

  @@unique([tenantId, sourceCorrelationId])
  @@map("schedule_applications")
  @@index([tenantId, openItemId])
  @@index([tenantId, scheduleNumber, controlNumber])
}

// Nightly (or on-demand) reconciliation of schedule-service's own open-item
// balances against gl-service's GL control-account ending balance. Discrepancies
// are persisted and exposed — never silently corrected on either side.
model ScheduleGlTieOut {
  id              String   @id @default(cuid())
  tenantId        String   @map("tenant_id")
  scheduleNumber  String   @db.Char(2) @map("schedule_number")
  glAccountNumber String   @db.VarChar(20) @map("gl_account_number")
  asOfDate        DateTime @map("as_of_date")

  scheduleBalance Decimal @db.Decimal(15, 2) @map("schedule_balance")
  glBalance       Decimal? @db.Decimal(15, 2) @map("gl_balance")
  variance        Decimal? @db.Decimal(15, 2)

  // MATCHED | DISCREPANCY | GL_UNAVAILABLE
  status       String  @default("MATCHED")
  glQueryError String? @map("gl_query_error")
  // Groups every row produced by one tie-out run.
  runId        String  @map("run_id")
  triggeredBy  String? @map("triggered_by")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("schedule_gl_tie_outs")
  @@unique([tenantId, scheduleNumber, glAccountNumber, asOfDate, runId])
  @@index([tenantId, asOfDate])
  @@index([tenantId, status])
  @@index([tenantId, runId])
}

// @wave S027 — Schedule Aging Engine.
// Per-tenant configurable aging bucket definitions — not hard-coded.
// `buckets` is an ordered JSON array of {label, upperBoundDays} where
// upperBoundDays is the inclusive day-count boundary for that bucket (an
// item ages into the first bucket whose upperBoundDays >= its age in days);
// the last bucket's upperBoundDays MUST be null (catch-all, e.g. "90+").
// Default (applied when a tenant has no row here — see domain/aging.ts
// DEFAULT_AGING_BUCKETS): Current(<=0) / 1-30 / 31-60 / 61-90 / 90+,
// extending the legacy CUR/OVR30/OVR60/OVR90 convention
// (komdetail.extraction.md) with the standard AR 1-30 split since the
// legacy extraction did not document exact day boundaries.
model ScheduleAgingBucketConfig {
  id        String   @id @default(cuid())
  tenantId  String   @unique @map("tenant_id")
  buckets   Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("schedule_aging_bucket_configs")
}

/// S026: schedule-service had no audit mechanism at all before this (matches
/// the R0 Stabilization Phase 4 AuditPort pattern already shipped in
/// tenant-service/auth-service/coa-service/apar-service). Every open-item
/// create/apply/reverse and tie-out run writes a before/after record here;
/// AuditOutboxDrainer (wired in src/index.ts) drains unpublished rows to the
/// real S007 audit-service.
model AuditOutboxEvent {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  docType       String    @map("doc_type")
  docId         String    @map("doc_id")
  action        String
  before        Json?
  after         Json?
  actor         String
  correlationId String?   @map("correlation_id")
  publishedAt   DateTime? @map("published_at")
  retryCount    Int       @default(0) @map("retry_count")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, retryCount])
  @@map("audit_outbox")
}

/// Outbox pattern for reliable event publishing from schedule-service.
/// Written inside $transaction alongside state changes — never via direct publish.
model OutboxEvent {
  id            String    @id @default(cuid())
  eventType     String    @map("event_type")
  tenantId      String    @map("tenant_id")
  payload       Json
  correlationId String?   @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  retryCount    Int       @default(0) @map("retry_count")
  lastError     String?   @map("last_error")

  @@map("outbox_events")
  @@index([publishedAt, retryCount])
  @@index([createdAt])
}
