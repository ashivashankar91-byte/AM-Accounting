generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/apar-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "darwin-arm64"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AREntry {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  dealerRef String   @map("dealer_ref")
  type      String   // WARRANTY, FLOORPLAN, RECEIVABLE
  amount    Decimal  @db.Decimal(15, 2)
  dueDate   DateTime @map("due_date")
  status    String   @default("OPEN") // OPEN | POSTED | VOIDED | PENDING_MANUAL
  oemSource String?  @map("oem_source")
  createdAt DateTime @default(now()) @map("created_at")

  /// S4-04: journal source code (30=service, 32=parts, 56=manual)
  journalSource        String?   @map("journal_source") @db.VarChar(2)
  /// S4-04: RO or INVOICE or MANUAL
  sourceDocumentType   String?   @map("source_document_type") @db.VarChar(20)
  /// S4-04: the RO# or Invoice# that generated this receipt
  sourceDocumentNumber String?   @map("source_document_number") @db.VarChar(20)
  /// S4-04: who ran the cash register
  cashierUserId        String?   @map("cashier_user_id")
  /// S4-04: when cashiering happened
  cashierDateTime      DateTime? @map("cashier_date_time")
  /// S4-04: customer's portion when split payment
  customerPayPortion   Decimal?  @map("customer_pay_portion") @db.Decimal(15, 2)
  /// S4-04: name printed on the check (may differ from customer)
  checkName            String?   @map("check_name") @db.VarChar(50)
  /// S4-04: free text notes
  remarks              String?
  /// S6-10: IRS Form 8300 — number of $100 bills received (required when cash >= $10,000)
  cash100BillCount     Int?      @default(0) @map("cash_100_bill_count")

  @@map("ar_entries")
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, journalSource])
}

model APEntry {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  vendorName  String    @map("vendor_name")
  invoiceRef  String    @map("invoice_ref")
  amount      Decimal   @db.Decimal(15, 2)
  dueDate     DateTime  @map("due_date")
  /// S2-06: status values — OPEN | PARTIAL | PAID | VOID (plus legacy OPEN)
  status      String    @default("OPEN")
  glAccountId String?   @map("gl_account_id")
  /// S2-07: check fields populated when payment is issued
  checkNumber String?   @db.VarChar(20) @map("check_number")
  checkDate   DateTime? @map("check_date")
  paidDate    DateTime? @map("paid_date")
  /// S2-07: purchase order reference
  poNumber    String?   @db.VarChar(20) @map("po_number")
  /// S2-07: hold flag — prevents payment when true
  holdFlag    Boolean   @default(false) @map("hold_flag")
  /// S2-07: free-form note visible in approval queue
  note        String?
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("ap_entries")
  @@index([tenantId])
  @@index([tenantId, status])
}

/// S2-08: AP payment cleared fields for bank reconciliation
model APPayment {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  apEntryId     String    @map("ap_entry_id")
  paymentDate   DateTime  @map("payment_date")
  amount        Decimal   @db.Decimal(15, 2)
  checkNumber   String?   @db.VarChar(20) @map("check_number")
  /// S2-08: bank reconciliation cleared flag
  clearedFlag   Boolean   @default(false) @map("cleared_flag")
  /// S2-08: date the check cleared the bank
  clearedDate   DateTime? @map("cleared_date")
  /// S3-08: voided check fields
  voidedAt      DateTime? @map("voided_at")
  voidReason    String?   @map("void_reason")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("ap_payments")
  @@index([tenantId])
  @@index([tenantId, clearedFlag])
  @@index([apEntryId])
}

/// Outbox pattern for reliable event publishing from apar-service.
/// Written inside $transaction alongside state changes — never via direct publish.
model OutboxEvent {
  id            String    @id @default(uuid())
  eventType     String    @map("event_type")
  tenantId      String    @map("tenant_id")
  payload       Json
  correlationId String?   @map("correlation_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  publishedAt   DateTime? @map("published_at")
  retryCount    Int       @default(0) @map("retry_count")
  lastError     String?   @map("last_error")

  @@map("outbox_events")
  @@index([publishedAt, retryCount])
  @@index([createdAt])
}

/// S5-01: Customer master — NAME_DATABASE CUSTOMER records.
/// S046 (AMACC-CH04): hardened in place (additive-only) — tenant isolation/RLS,
/// lifecycle (ACTIVE/INACTIVE/DELETED), optimistic concurrency, duplicate
/// detection and a credit profile (limit/hold/terms). See MODULE_STATE.md /
/// S046 commit for the convergence decision: this stays the single customer
/// system of record — no parallel customer table was created. Statements,
/// invoicing, receipts, cash application, write-offs and NSF processing
/// (also named in the S046 story title/epic) are explicitly OUT of this
/// slice's scope — see later stories S047-S051.
model Customer {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  customerNumber        String    @db.VarChar(20) @map("customer_number")
  /// S046: uppercased/trimmed comparison form of customerNumber. Backfilled
  /// for existing rows; maintained by CustomerService on every write.
  normalizedCustomerNumber String @map("normalized_customer_number")
  customerName          String    @map("customer_name")
  /// S046: lower/trimmed comparison form of customerName — duplicate
  /// candidate signal (paired with zip).
  normalizedCustomerName String   @map("normalized_customer_name")
  customerType          String    @default("Individual") @map("customer_type") // Individual | Business | Government | Fleet
  salespersonCode       String?   @db.VarChar(10) @map("salesperson_code")
  arAccountOverride     String?   @map("ar_account_override") // GL account UUID
  companyNumber         String?   @db.VarChar(4) @map("company_number")
  taxId                 String?   @map("tax_id")
  taxExemptStatus       Boolean   @default(false) @map("tax_exempt_status")
  taxExemptCertNumber   String?   @map("tax_exempt_cert_number")
  taxExemptExpiration   DateTime? @map("tax_exempt_expiration")
  creditLimit           Decimal   @default(0) @db.Decimal(15, 2) @map("credit_limit")
  creditTerms           String    @default("Net30") @map("credit_terms")
  /// S046: credit hold — blocks new-charge eligibility (mirrors Vendor's
  /// ACTIVE-only invoice eligibility). Distinct from lifecycle status: a
  /// customer can be ACTIVE but on credit hold.
  creditHold            Boolean   @default(false) @map("credit_hold")
  creditHoldReason      String?   @map("credit_hold_reason")
  creditHoldSetAt       DateTime? @map("credit_hold_set_at")
  creditHoldSetBy       String?   @map("credit_hold_set_by")
  creditHoldClearedAt   DateTime? @map("credit_hold_cleared_at")
  creditHoldClearedBy   String?   @map("credit_hold_cleared_by")
  /// S046: effective date of the current credit profile (limit/terms/hold) —
  /// updated whenever any credit-profile field changes.
  creditProfileEffectiveDate DateTime? @map("credit_profile_effective_date")
  customerSince         DateTime  @default(now()) @map("customer_since")
  preferredContactMethod String   @default("Phone") @map("preferred_contact_method")
  doNotSolicit          Boolean   @default(false) @map("do_not_solicit")
  doNotMail             Boolean   @default(false) @map("do_not_mail")
  // Primary address
  address1              String?
  address2              String?
  city                  String?
  state                 String?   @db.VarChar(2)
  zip                   String?   @db.VarChar(10)
  country               String?   @default("US")
  phone                 String?
  /// S046: digits-only comparison form of phone — duplicate candidate signal.
  normalizedPhone        String?  @map("normalized_phone")
  phone2                 String?
  fax                    String?
  email                  String?
  /// S046: lowercased/trimmed comparison form of email — duplicate candidate signal.
  normalizedEmail        String?  @map("normalized_email")
  // Secondary / alternate address
  secondaryStreet       String?   @map("secondary_street")
  secondaryCity         String?   @map("secondary_city")
  secondaryState        String?   @db.VarChar(2) @map("secondary_state")
  secondaryZip          String?   @db.VarChar(10) @map("secondary_zip")
  secondaryCountry      String?   @map("secondary_country")
  addressLabel          String?   @map("address_label") // "Billing", "Shipping", etc.
  // Module flags (Name Database AVPSFE pattern)
  flagAR                Boolean   @default(false) @map("flag_ar")   // A = AR
  flagVehicle           Boolean   @default(false) @map("flag_vehicle") // V = Vehicle
  flagParts             Boolean   @default(false) @map("flag_parts")  // P = Parts
  flagService           Boolean   @default(false) @map("flag_service") // S = Service
  flagFI                Boolean   @default(false) @map("flag_fi")    // F = F&I
  employeeFlag          Boolean   @default(false) @map("employee_flag") // E = Employee
  // Notes (append-only JSON array of { timestamp, user, text })
  notes                 Json?
  /// S046: ACTIVE | INACTIVE | DELETED. isActive below is kept in sync by
  /// CustomerService on every write for read-path backward compatibility
  /// with pre-S046 consumers that filter on it directly.
  status                 String   @default("ACTIVE")
  isActive              Boolean   @default(true) @map("is_active")
  /// S046: optimistic-concurrency version. Incremented on every update/lifecycle change.
  version                Int      @default(1)
  inactiveReason         String?  @map("inactive_reason")
  inactivatedAt          DateTime? @map("inactivated_at")
  inactivatedBy          String?  @map("inactivated_by")
  reactivatedAt          DateTime? @map("reactivated_at")
  reactivatedBy          String?  @map("reactivated_by")
  /// Logical delete only — a row is never physically removed (BR-AP-001,
  /// same convention applied to the customer master by S046).
  deletedAt              DateTime? @map("deleted_at")
  deletedBy              String?  @map("deleted_by")
  deleteReason           String?  @map("delete_reason")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, customerNumber])
  @@map("customers")
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, customerName])
  @@index([tenantId, status])
  @@index([tenantId, normalizedCustomerNumber])
  @@index([tenantId, normalizedCustomerName])
  @@index([tenantId, normalizedEmail])
  @@index([tenantId, normalizedPhone])
}

/// S046: per-tenant atomic customer-number counter — replaces the pre-S046
/// `SELECT count(*)+1` generation in routes.ts, which raced under concurrent
/// creates. Mirrors ApVendorNumberCounter (S036A).
model ArCustomerNumberCounter {
  tenantId   String @id @map("tenant_id")
  nextNumber Int    @default(1) @map("next_number")

  @@map("ar_customer_number_counters")
}

/// S046: persisted record of a user acknowledging a duplicate-customer
/// warning and choosing to create the customer anyway. Requires
/// AR_CUSTOMER_DUPLICATE_OVERRIDE (server-enforced) and an explicit reason.
model ArCustomerDuplicateAcknowledgement {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  customerId     String   @map("customer_id")
  /// Array of { customerId, customerNumber, customerName, status, matchedSignals }.
  matchedSignals Json     @map("matched_signals")
  reason         String
  actor          String
  correlationId  String?  @map("correlation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, customerId])
  @@map("ar_customer_duplicate_acknowledgements")
}

/// S3-07: Vendor master — AP_VENDOR legacy equivalent
/// AMACC-CH04 S036A: hardened in place (additive-only) — tenant isolation/RLS,
/// lifecycle (ACTIVE/INACTIVE/DELETED), optimistic concurrency, duplicate
/// detection and sensitive-field masking. See MODULE_STATE.md / S036A commit
/// for the convergence decision: this stays the single vendor system of
/// record — no parallel `ap_vendors` table was created.
model Vendor {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  vendorNumber         String    @db.VarChar(20) @map("vendor_number")
  /// S036A: uppercased/trimmed comparison form of vendorNumber. Backfilled
  /// for existing rows; maintained by VendorService on every write.
  normalizedVendorNumber String  @map("normalized_vendor_number")
  vendorName           String    @map("vendor_name")
  /// S036A: lower/trimmed comparison form of vendorName — duplicate-name
  /// candidate signal (paired with postalCode/zip).
  normalizedVendorName String    @map("normalized_vendor_name")
  dba                  String?
  /// S036A: SUPPLIER | SERVICE_PROVIDER | GOVERNMENT | OTHER
  vendorType           String    @default("OTHER") @map("vendor_type")
  contactName          String?   @map("contact_name")
  phone                String?
  /// S036A: digits-only comparison form of phone — duplicate candidate signal.
  normalizedPhone      String?   @map("normalized_phone")
  fax                  String?
  email                String?
  /// S036A: lowercased/trimmed comparison form of email — duplicate candidate signal.
  normalizedEmail      String?   @map("normalized_email")
  address1             String?   @map("address1")
  address2             String?   @map("address2")
  city                 String?
  state                String?   @db.VarChar(2)
  zip                  String?   @db.VarChar(10)
  /// S036A: tax identifier. NO NEW PLAINTEXT WRITES — create/edit disabled at
  /// the API layer pending an approved encrypted-field platform mechanism
  /// (none exists repository-wide as of this migration). Existing plaintext
  /// values are preserved untouched (no destructive/transforming migration).
  /// API responses mask to last-4 only; full reveal is not implemented this
  /// slice even with AP_VENDOR_TAX_IDENTIFIER_VIEW (see docs — security
  /// dependency, not invented cryptography).
  taxId                String?   @map("tax_id")
  is1099Misc           Boolean   @default(false) @map("is_1099_misc")
  is1099Nec            Boolean   @default(false) @map("is_1099_nec")
  income1099Type       String?   @map("income_1099_type")
  w9OnFile             Boolean   @default(false) @map("w9_on_file")
  w9ReceivedDate       DateTime? @map("w9_received_date")
  /// Opaque payment-terms code — S036A preserves this as-is (no new reference
  /// subsystem introduced; no accepted payment-terms reference data source
  /// exists in the repository).
  paymentTerms         String    @default("Net30") @map("payment_terms")
  defaultGlAccount     String?   @map("default_gl_account")
  /// S036A out of scope (payment-run mechanics). Untouched, no longer
  /// writable via the hardened create/update API.
  paymentMethod        String    @default("Check") @map("payment_method")
  discountPercent      Decimal   @default(0) @db.Decimal(5, 2) @map("discount_percent")
  discountDays         Int       @default(0) @map("discount_days")
  /// S036A out of scope (banking storage). Untouched, no longer writable via
  /// the hardened create/update API — hidden/disabled at the UI layer too.
  bankName             String?   @map("bank_name")
  bankRoutingNumber    String?   @db.VarChar(9) @map("bank_routing_number")
  bankAccountNumber    String?   @map("bank_account_number")
  bankAccountType      String?   @map("bank_account_type")
  separateCheck        Boolean   @default(false) @map("separate_check")
  holdPayments         Boolean   @default(false) @map("hold_payments")
  defaultExpenseAccount String?  @map("default_expense_account")
  notes                String?
  /// S036A: ACTIVE | INACTIVE | DELETED. isActive below is kept in sync by
  /// VendorService for read-path backward compatibility with pre-S036A
  /// consumers (1099 listing, payment-reconciliation join) that filter on it
  /// directly.
  status               String    @default("ACTIVE")
  isActive             Boolean   @default(true) @map("is_active")
  /// Optimistic-concurrency version. Incremented on every update/lifecycle change.
  version              Int       @default(1)
  inactiveReason       String?   @map("inactive_reason")
  inactivatedAt        DateTime? @map("inactivated_at")
  inactivatedBy        String?   @map("inactivated_by")
  reactivatedAt        DateTime? @map("reactivated_at")
  reactivatedBy        String?   @map("reactivated_by")
  /// Logical delete only — a row is never physically removed (BR-AP-001).
  deletedAt            DateTime? @map("deleted_at")
  deletedBy            String?   @map("deleted_by")
  deleteReason         String?   @map("delete_reason")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, vendorNumber])
  @@map("vendors")
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, status])
  @@index([tenantId, normalizedVendorNumber])
  @@index([tenantId, normalizedVendorName])
  @@index([tenantId, normalizedEmail])
  @@index([tenantId, normalizedPhone])
}

/// S036A: per-tenant atomic vendor-number counter. Replaces the pre-existing
/// `count()+1` generation in routes.ts, which raced under concurrent creates
/// (two requests could both read the same count and collide on the
/// tenantId+vendorNumber unique constraint). An UPDATE ... RETURNING against
/// this row is atomic under Postgres row locking — no SERIALIZABLE/retry
/// helper needed.
model ApVendorNumberCounter {
  tenantId   String @id @map("tenant_id")
  nextNumber Int    @default(1) @map("next_number")

  @@map("ap_vendor_number_counters")
}

/// S036A: persisted record of a user acknowledging a duplicate-vendor
/// warning and choosing to create the vendor anyway. Requires
/// AP_VENDOR_DUPLICATE_OVERRIDE (server-enforced) and an explicit reason.
model ApVendorDuplicateAcknowledgement {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  vendorId       String   @map("vendor_id")
  /// Array of { type, candidateVendorId, candidateVendorNumber, candidateVendorName }.
  /// Never includes full protected values (no raw taxId/email/phone stored here).
  matchedSignals Json     @map("matched_signals")
  reason         String
  actor          String
  correlationId  String?  @map("correlation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, vendorId])
  @@map("ap_vendor_duplicate_acknowledgements")
}

/// AMACC-CH04 S036B: Vendor Compliance Adapters. Additive to the S036A
/// vendor master — no changes to the `vendors` table. checkType is a label
/// only (no regulatory logic keyed off it); jurisdiction/country are captured
/// as data, never evaluated against any rule. status starts PENDING_REVIEW on
/// create; runVerification() calls the configured ComplianceVerificationAdapter
/// (ManualComplianceAdapter by default — always truthfully NOT_CONFIGURED,
/// never a fabricated VERIFIED); VERIFIED/REJECTED/EXPIRED are only reachable
/// via an explicit human review action (see VendorComplianceService.review).
model VendorComplianceCheck {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  vendorId          String    @map("vendor_id")
  /// TAX_ID_VERIFICATION | INSURANCE_CERTIFICATE | W9_VERIFICATION | GENERAL_COMPLIANCE_DOCUMENT | OTHER
  checkType         String    @map("check_type")
  /// NOT_CONFIGURED | PENDING_REVIEW | VERIFICATION_UNAVAILABLE | VERIFIED | REJECTED | EXPIRED
  status            String    @default("PENDING_REVIEW")
  jurisdiction      String?
  country           String?
  externalReference String?   @map("external_reference")
  notes             String?
  /// Name of the adapter that last ran (e.g. 'MANUAL'). Null until runVerification() is called once.
  providerName      String?   @map("provider_name")
  resultMessage     String?   @map("result_message")
  expirationDate    DateTime? @map("expiration_date")
  lastCheckedAt     DateTime? @map("last_checked_at")
  reviewedAt        DateTime? @map("reviewed_at")
  reviewedBy        String?   @map("reviewed_by")
  reviewNote        String?   @map("review_note")
  version           Int       @default(1)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@index([tenantId])
  @@index([tenantId, vendorId])
  @@index([tenantId, status])
  @@map("vendor_compliance_checks")
}

/// S036A: apar-service had no audit mechanism at all before this (matches the
/// R0 Stabilization Phase 4 AuditPort pattern already shipped in
/// tenant-service/auth-service/coa-service). Every vendor create/update/
/// inactivate/reactivate/delete/duplicate-acknowledge/eligibility-denial/
/// sensitive-field-view writes a before/after record here; AuditOutboxDrainer
/// (wired in src/index.ts) drains unpublished rows to the real S007
/// audit-service.
model AuditOutboxEvent {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  docType     String    @map("doc_type")
  docId       String    @map("doc_id")
  action      String
  before      Json?
  after       Json?
  actor       String
  /// S036A certification: correlation ID for the request/action that
  /// produced this event. Nullable — other services writing to this shared
  /// table don't populate it.
  correlationId String? @map("correlation_id")
  publishedAt DateTime? @map("published_at")
  retryCount  Int       @default(0) @map("retry_count")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, retryCount])
  @@map("audit_outbox")
}

/// S6-01/02/03: Purchase Order master — PO state machine with Cancel vs Void separation
/// CANCEL: DRAFT only, no PO# consumed. VOID: SUBMITTED/APPROVED, PO# consumed, audit record.
model PurchaseOrder {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  poNumber        String?   @db.VarChar(20) @map("po_number")          // NULL = DRAFT (no PO# assigned)
  poType          String    @default("GENERAL") @map("po_type")         // GENERAL | SUBLET | VEHICLE
  vendorId        String?   @map("vendor_id")
  vendorName      String?   @map("vendor_name")
  department      String?   @db.VarChar(50)
  requestedBy     String?   @map("requested_by")
  shipTo          String?   @map("ship_to")
  poDate          DateTime  @default(now()) @map("po_date") @db.Date
  requiredDate    DateTime? @map("required_date") @db.Date
  notes           String?
  status          String    @default("DRAFT") @map("status")
  // status values: DRAFT | SUBMITTED | APPROVED | PARTIALLY_RECEIVED | RECEIVED | CLOSED | CANCELLED | VOIDED
  approvalLevel   Int       @default(0) @map("approval_level")
  approvedBy      String?   @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  lineTotal       Decimal   @default(0) @db.Decimal(15, 2) @map("line_total")
  freight         Decimal   @default(0) @db.Decimal(15, 2)
  tax             Decimal   @default(0) @db.Decimal(15, 2)
  total           Decimal   @default(0) @db.Decimal(15, 2)
  /// S6-02: Sublet PO link to Repair Order
  roNumber        String?   @db.VarChar(20) @map("ro_number")
  /// S6-01: Void metadata
  voidedAt        DateTime? @map("voided_at")
  voidReason      String?   @map("void_reason")
  voidedBy        String?   @map("voided_by")
  /// S6-02: Cancelled metadata (DRAFT only)
  cancelledAt     DateTime? @map("cancelled_at")
  cancelReason    String?   @map("cancel_reason")
  isActive        Boolean   @default(true) @map("is_active")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  lines           POLine[]

  @@map("purchase_orders")
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, poNumber])
}

/// S6-01: Purchase Order line items
model POLine {
  id          String   @id @default(uuid())
  poId        String   @map("po_id")
  lineNumber  Int      @map("line_number")
  description String
  qty         Decimal  @db.Decimal(10, 2)
  unitCost    Decimal  @db.Decimal(15, 2) @map("unit_cost")
  extCost     Decimal  @db.Decimal(15, 2) @map("ext_cost")
  glAccountId String?  @map("gl_account_id")
  controlNumber String? @db.VarChar(20) @map("control_number")

  po          PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)

  @@map("po_lines")
  @@index([poId])
}

/// S3-09: AP bank account with sequential check number sequence
model APBankAccount {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  bankName        String   @map("bank_name")
  accountNumber   String   @map("account_number")
  routingNumber   String   @map("routing_number")
  nextCheckNumber Int      @default(1001) @map("next_check_number")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, accountNumber])
  @@map("ap_bank_accounts")
  @@index([tenantId])
}

/// S038: Vendor insurance-certificate record. Owns the certificate's
/// lifecycle (create → renew/supersede → revoke), expiration status and the
/// user-facing workflow. Reuses S036A's Vendor as the sole vendor identity —
/// no second vendor table is introduced here.
///
/// S036B boundary: this model has NO "verified"/"compliance status" field.
/// S036B owns external compliance-verification adapters and any resulting
/// summary status; S038 only exposes the raw certificate facts (dates,
/// provider, coverage, lifecycle, computed expiration) that a future S036B
/// adapter can read via the service-layer summary method / VENDOR_INSURANCE_
/// CERTIFICATE_* outbox events. Do not add verification fields here.
model VendorInsuranceCertificate {
  id                   String    @id @default(uuid())
  tenantId             String    @map("tenant_id")
  vendorId             String    @map("vendor_id")

  /// SUPPLIER-provided policy/certificate number (not internally generated).
  certificateNumber    String    @map("certificate_number")
  insuranceProvider    String    @map("insurance_provider")
  /// GENERAL_LIABILITY | AUTO_LIABILITY | WORKERS_COMP | UMBRELLA | PROPERTY | OTHER.
  /// A plain categorization value only — S038 does not encode which coverage
  /// types are legally required for any jurisdiction (out of scope; no
  /// regulation/jurisdiction rule is invented here).
  insuranceType        String    @map("insurance_type")

  effectiveDate        DateTime  @map("effective_date")
  expirationDate       DateTime  @map("expiration_date")

  /// Optional — free-form coverage limit and description. Not validated
  /// against any regulatory minimum (none is accepted/known for S038).
  coverageAmount       Decimal?  @db.Decimal(15, 2) @map("coverage_amount")
  coverageDescription  String?   @map("coverage_description")

  /// Document metadata/reference only (per repository convention — large
  /// binaries are not stored in this table). documentId references a
  /// document-service Document id by value; no cross-service DB join/FK.
  documentId           String?   @map("document_id")
  documentFileName     String?   @map("document_file_name")
  documentMimeType     String?   @map("document_mime_type")

  /// Lifecycle status — ACTIVE | SUPERSEDED | REVOKED. Distinct from
  /// time-based expiration (computed at read-time, never stored) — an
  /// ACTIVE record can still be past its expirationDate if nobody has
  /// renewed it yet; that historical fact must remain visible.
  status               String    @default("ACTIVE")
  /// True only for the single current certificate per (vendorId,
  /// insuranceType). Enforced by a partial unique index below — this is the
  /// duplicate-active-certificate protection.
  isCurrent            Boolean   @default(true) @map("is_current")

  /// Renewal/replacement chain — set on the OLD record when a new
  /// certificate supersedes it. Historical certificates are never deleted.
  supersededByCertificateId String? @map("superseded_by_certificate_id")
  /// Set on the NEW record, pointing back at what it replaced (nullable —
  /// absent for a certificate's first-ever record for that vendor/type).
  previousCertificateId     String? @map("previous_certificate_id")

  revokedAt            DateTime? @map("revoked_at")
  revokedReason         String?  @map("revoked_reason")
  revokedBy             String?  @map("revoked_by")

  notes                String?

  /// Optimistic-concurrency version. Incremented on every update/lifecycle change.
  version              Int       @default(1)

  createdAt            DateTime  @default(now()) @map("created_at")
  createdBy            String?   @map("created_by")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  updatedBy            String?   @map("updated_by")

  @@map("vendor_insurance_certificates")
  @@index([tenantId])
  @@index([tenantId, vendorId])
  @@index([tenantId, status])
  @@index([tenantId, expirationDate])
  @@index([vendorId, insuranceType, isCurrent])
}

/// AMACC-CH04 S039: Goods Receipt — records quantities actually received
/// against a PurchaseOrder line. No such model existed before S039 (see
/// S039 discovery notes) — required as the "receipt" leg of 3-way match
/// (PO vs Receipt vs Invoice). Reuses the existing PurchaseOrder/POLine
/// master — no parallel PO system is introduced.
model GoodsReceipt {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  poId          String    @map("po_id")
  receiptNumber String    @map("receipt_number")
  receiptDate   DateTime  @default(now()) @map("receipt_date") @db.Date
  receivedBy    String?   @map("received_by")
  /// OPEN | VOID. A GoodsReceipt is never edited in place once created — a
  /// mis-keyed receipt is voided (with reason) and a corrected one entered,
  /// same BR-AP-001-style convention as Vendor/Customer soft-delete.
  status        String    @default("OPEN")
  notes         String?
  voidedAt      DateTime? @map("voided_at")
  voidedBy      String?   @map("voided_by")
  voidReason    String?   @map("void_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  createdBy     String?   @map("created_by")

  lines         GoodsReceiptLine[]

  @@map("goods_receipts")
  @@index([tenantId])
  @@index([tenantId, poId])
  @@index([tenantId, status])
}

/// S039: Goods Receipt line — quantity received against one PO line.
model GoodsReceiptLine {
  id             String   @id @default(uuid())
  receiptId      String   @map("receipt_id")
  poLineId       String   @map("po_line_id")
  lineNumber     Int      @map("line_number")
  description    String
  qtyReceived    Decimal  @db.Decimal(10, 2) @map("qty_received")

  receipt        GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("goods_receipt_lines")
  @@index([receiptId])
  @@index([poLineId])
}

/// AMACC-CH04 S039: Vendor Invoice header — AP Invoice Entry & 2/3-Way
/// Match. Registered in the Fable canonical registry (id S039, epic CE-09,
/// release R2) only as a summary row — EXPANSION_PENDING, no accepted
/// acceptance criteria/field list exists (see S039 discovery notes in the
/// integration session). Built as a configurable framework rather than
/// invented policy: matching tolerance is tenant/vendor-configurable
/// (ApInvoiceMatchToleranceConfig, conservative 0.00 default — see
/// InvoiceMatchService), GL coding is via the existing gl_accounts
/// reference (no fabricated account numbers), and posting/approval
/// authority is explicitly OUT of S039's scope (see S041 Invoice Approval
/// Matrix — this model's lifecycle stops at SUBMITTED).
model VendorInvoice {
  id                    String    @id @default(uuid())
  tenantId              String    @map("tenant_id")
  vendorId              String    @map("vendor_id")
  invoiceNumber         String    @map("invoice_number")
  /// Uppercased/trimmed comparison form — duplicate-invoice detection
  /// signal, same convention as Vendor.normalizedVendorNumber.
  normalizedInvoiceNumber String  @map("normalized_invoice_number")
  invoiceDate           DateTime  @map("invoice_date") @db.Date
  dueDate               DateTime  @map("due_date") @db.Date
  /// Copied from Vendor.paymentTerms at create time (a snapshot, not a
  /// live reference — an invoice's terms shouldn't silently change if the
  /// vendor master record is edited later).
  paymentTerms          String    @map("payment_terms")
  /// Optional PO linkage. NULL = non-PO invoice (no match is run; GL lines
  /// must be coded directly — see VendorInvoiceLine.glAccountId).
  poId                  String?   @map("po_id")

  subtotal              Decimal   @default(0) @db.Decimal(15, 2)
  taxAmount             Decimal   @default(0) @db.Decimal(15, 2) @map("tax_amount")
  freightAmount         Decimal   @default(0) @db.Decimal(15, 2) @map("freight_amount")
  totalAmount           Decimal   @default(0) @db.Decimal(15, 2) @map("total_amount")

  /// DRAFT | SUBMITTED | PENDING_APPROVAL | APPROVED | REJECTED | VOID.
  /// PENDING_APPROVAL/APPROVED/REJECTED are driven by S041's
  /// ApInvoiceApprovalInstance/Step — see invoice-approval-service.ts.
  status                String    @default("DRAFT")
  /// NONE (no PO) | TWO_WAY (PO+Invoice) | THREE_WAY (PO+Receipt+Invoice).
  /// Determined automatically by InvoiceMatchService from the PO's receipt
  /// history at match-run time — never caller-supplied.
  matchType             String    @default("NONE") @map("match_type")
  /// NOT_RUN | MATCHED | EXCEPTION | OVERRIDDEN. OVERRIDDEN means an
  /// EXCEPTION result was explicitly bypassed by a permitted user with a
  /// reason (see ApInvoiceMatchOverride) — never silently cleared.
  matchStatus           String    @default("NOT_RUN") @map("match_status")

  notes                 String?
  /// Optimistic-concurrency version — same convention as Vendor/Customer.
  version                Int      @default(1)

  submittedAt            DateTime? @map("submitted_at")
  submittedBy             String?  @map("submitted_by")
  voidedAt               DateTime? @map("voided_at")
  voidedBy                String?  @map("voided_by")
  voidReason              String?  @map("void_reason")
  /// AMACC-CH04 S041: gl-service JournalEntry id for the AP liability entry
  /// created when the approval matrix's final tier approves this invoice
  /// (Dr expense/asset lines, Cr vendor AP control account). Null until
  /// approved. The entry is created + submitted for review (PENDING_REVIEW)
  /// — S041 never force-calls approveJournalEntry itself; posting completion
  /// is the GL agent-review/human step, same gate as every other journal
  /// entry (PO-DEC-001). schedule-service picks up the resulting
  /// JOURNAL_ENTRY_POSTED event automatically once it actually posts — no
  /// new schedule logic is introduced here.
  approvalGlEntryId      String?   @map("approval_gl_entry_id")

  createdAt              DateTime  @default(now()) @map("created_at")
  createdBy              String?   @map("created_by")
  updatedAt              DateTime  @updatedAt @map("updated_at")
  updatedBy              String?   @map("updated_by")

  lines                  VendorInvoiceLine[]
  matchResults           VendorInvoiceMatchResult[]

  @@map("vendor_invoices")
  @@index([tenantId])
  @@index([tenantId, vendorId])
  @@index([tenantId, status])
  @@index([tenantId, poId])
  @@index([tenantId, normalizedInvoiceNumber])
}

/// S039: Vendor Invoice line item. Either linked to a PO line (poLineId set
/// — matched against that line's unitCost/qty) or coded directly to a GL
/// account (glAccountId set, non-PO invoice). Exactly one of the two is
/// populated — enforced in InvoiceService, not by a DB constraint (Prisma
/// has no native XOR check; a raw CHECK constraint is added in the
/// migration instead, matching the ScheduleOpenItem precedent).
model VendorInvoiceLine {
  id            String   @id @default(uuid())
  invoiceId     String   @map("invoice_id")
  lineNumber    Int      @map("line_number")
  poLineId      String?  @map("po_line_id")
  glAccountId   String?  @map("gl_account_id")
  description   String
  quantity      Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal  @db.Decimal(15, 2) @map("unit_price")
  taxAmount     Decimal  @default(0) @db.Decimal(15, 2) @map("tax_amount")
  lineTotal     Decimal  @db.Decimal(15, 2) @map("line_total")

  invoice       VendorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("vendor_invoice_lines")
  @@index([invoiceId])
  @@index([poLineId])
}

/// S039: append-only match-run history. A new row is written every time
/// InvoiceMatchService.runMatch() executes (re-running after a line edit
/// creates a new row rather than overwriting) — gives a full audit trail of
/// what tolerance was in effect and what variances were found at each run.
model VendorInvoiceMatchResult {
  id                    String   @id @default(uuid())
  tenantId              String   @map("tenant_id")
  invoiceId             String   @map("invoice_id")
  matchType             String   @map("match_type")
  /// MATCHED | EXCEPTION
  status                String
  toleranceAmountUsed   Decimal  @db.Decimal(15, 2) @map("tolerance_amount_used")
  tolerancePercentUsed  Decimal  @db.Decimal(5, 2) @map("tolerance_percent_used")
  /// Array of { poLineId, invoiceLineId, type, expected, actual, varianceAmount, withinTolerance }
  variances             Json
  matchedAt             DateTime @default(now()) @map("matched_at")
  matchedBy             String?  @map("matched_by")

  invoice               VendorInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("vendor_invoice_match_results")
  @@index([tenantId, invoiceId])
}

/// S039: tenant/vendor-configurable 2-way/3-way match tolerance — mirrors
/// the CashVarianceToleranceConfig (S052) scope-resolution pattern exactly
/// (VENDOR -> TENANT -> 0.00, see InvoiceMatchService.resolveTolerance).
/// No configured tolerance means only an exact match avoids EXCEPTION — the
/// conservative default, never a silently invented accounting assumption.
model ApInvoiceMatchToleranceConfig {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  /// VENDOR | TENANT
  scope             String
  /// vendorId when scope=VENDOR; null when scope=TENANT.
  scopeId           String?  @map("scope_id")
  amountTolerance   Decimal  @default(0) @db.Decimal(15, 2) @map("amount_tolerance")
  percentTolerance  Decimal  @default(0) @db.Decimal(5, 2) @map("percent_tolerance")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, scope, scopeId])
  @@map("ap_invoice_match_tolerance_configs")
  @@index([tenantId])
}

/// S039: persisted record of a user overriding a MATCH_EXCEPTION result (or
/// a duplicate-invoice-number warning) to submit anyway. Mirrors
/// ApVendorDuplicateAcknowledgement — requires an explicit reason and the
/// route-enforced ap.invoice.match_override / ap.invoice.duplicate_override
/// permission.
model ApInvoiceMatchOverride {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  invoiceId      String   @map("invoice_id")
  /// MATCH_EXCEPTION | DUPLICATE_INVOICE_NUMBER
  overrideType   String   @map("override_type")
  /// For MATCH_EXCEPTION: the variances bypassed. For duplicate: the
  /// matched candidate invoice(s).
  context        Json
  reason         String
  actor          String
  correlationId  String?  @map("correlation_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, invoiceId])
  @@map("ap_invoice_match_overrides")
}

/// AMACC-CH04 S041: Invoice Approval Matrix. Fable canonical registry
/// record for S041 is a summary row only (id S041, epic CE-09, release R2)
/// — EXPANSION_PENDING, no accepted thresholds/roles/workflow exist.
/// Built as a configurable framework: a tenant defines its own tiers
/// (dollar threshold -> required role), never a hard-coded invented
/// approval policy. If a tenant has configured no rules at all, the
/// conservative default (see InvoiceApprovalRuleService) requires exactly
/// one approval from any user holding ap.invoice_approval.approve — never
/// zero required approvals / never a silent auto-approve.
model ApInvoiceApprovalRule {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  /// This tier applies when the invoice's totalAmount >= thresholdAmount.
  thresholdAmount  Decimal  @db.Decimal(15, 2) @map("threshold_amount")
  /// Role label required to act on this tier — one of the roles already
  /// known to the authz catalog (ADMIN | CONTROLLER | ACCOUNTANT), never an
  /// invented new role.
  requiredRole     String   @map("required_role")
  /// Evaluation order — lower sequence must approve before a higher
  /// sequence tier becomes actionable.
  sequence         Int
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, sequence])
  @@map("ap_invoice_approval_rules")
  @@index([tenantId, isActive])
}

/// S041: one approval workflow instance per submitted VendorInvoice.
model ApInvoiceApprovalInstance {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  invoiceId           String    @unique @map("invoice_id")
  /// PENDING | APPROVED | REJECTED
  status              String    @default("PENDING")
  totalAmountSnapshot Decimal   @db.Decimal(15, 2) @map("total_amount_snapshot")
  createdAt           DateTime  @default(now()) @map("created_at")
  createdBy           String?   @map("created_by")
  completedAt         DateTime? @map("completed_at")

  steps               ApInvoiceApprovalStep[]

  @@map("ap_invoice_approval_instances")
  @@index([tenantId])
  @@index([tenantId, status])
}

/// S041: one required tier of an approval instance.
model ApInvoiceApprovalStep {
  id             String    @id @default(uuid())
  instanceId     String    @map("instance_id")
  sequence       Int
  /// Role label required to decide this step, or 'ANY_APPROVER' for the
  /// no-rules-configured conservative default.
  requiredRole   String    @map("required_role")
  /// PENDING | APPROVED | REJECTED | SKIPPED (skipped once a prior step in
  /// the same instance is rejected — the instance is already decided).
  status         String    @default("PENDING")
  decidedBy      String?   @map("decided_by")
  decidedAt      DateTime? @map("decided_at")
  note           String?

  instance       ApInvoiceApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@map("ap_invoice_approval_steps")
  @@index([instanceId])
  @@unique([instanceId, sequence])
}
