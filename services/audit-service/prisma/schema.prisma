generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/audit-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// IMMUTABLE — database trigger prevents UPDATE and DELETE (SOC 2 / SOX compliance).
/// Records are append-only by design. See migration: make_auditlog_immutable.sql
model AuditLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  eventType     String   @map("event_type")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  actorType     String   @map("actor_type")
  actorId       String   @map("actor_id")
  actorName     String   @map("actor_name")
  action        String
  previousState Json?    @map("previous_state")
  newState      Json?    @map("new_state")
  reason        String?
  confidence    Float?
  metadata      Json?
  occurredAt    DateTime @map("occurred_at")
  ipAddress     String?  @map("ip_address")
  sessionId     String?  @map("session_id")
  /// R0 Stabilization Phase 4: the source outbox row's own id, when the record
  /// arrived via the AuditOutboxDrainer poller. Unique so retried/duplicate
  /// deliveries of the same outbox row are idempotent (insert-if-absent),
  /// never an UPDATE (the table is append-only/immutable by trigger).
  sourceEventId String?  @unique @map("source_event_id")

  /// S007 BR7-2 hash chain. hashSelf = sha256(hashPrev + canonical content of
  /// this row), computed synchronously at insert time (see AuditService.log).
  /// hashPrev is null only for the first row ever written in a partition
  /// (the chain's genesis record).
  hashPrev      String?  @map("hash_prev")
  hashSelf      String?  @map("hash_self")
  /// Generated column ('YYYY-MM' derived from occurred_at via date_part,
  /// zero-padded) || ':' || tenant_id — see the hash-chain migration for the
  /// exact expression (to_char is rejected by Postgres for generated
  /// columns: it is not IMMUTABLE, only date_part is).
  /// Computed by Postgres, never written by the application — see migration
  /// 20260727000001_add_hash_chain for why this is generated, not physically
  /// partitioned.
  partitionKey  String?  @map("partition_key")

  @@map("audit_logs")
  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([occurredAt])
  @@index([tenantId, eventType])
  @@index([partitionKey])
  /// S224 Document Audit History View: GET /audit/documents/:docType/:docId
  /// filters by exactly these three columns, ordered by occurredAt.
  @@index([tenantId, entityType, entityId, occurredAt], map: "audit_logs_tenant_entity_occurred_idx")
}

/// Mutable bookkeeping pointer to the current chain tail hash per partition.
/// NOT audit evidence itself (see migration 20260727000001_add_hash_chain) —
/// the audit_logs immutability guarantee does not apply to this table.
model AuditChainAnchor {
  partitionKey   String   @id @map("partition_key")
  tailHash       String?  @map("tail_hash")
  tailAuditLogId String?  @map("tail_audit_log_id")
  updatedAt      DateTime @default(now()) @map("updated_at")

  @@map("audit_chain_anchors")
}
