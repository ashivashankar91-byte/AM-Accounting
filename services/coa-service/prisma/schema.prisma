generator client {
  provider      = "prisma-client-js"
  output        = "../node_modules/.prisma/coa-client"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// S223 — Catalog of allowed configuration keys. Keys are catalog-controlled
/// (BR223-4): any PUT/GET against a key absent from this table is rejected 400.
/// Each key declares its value type and the scopes at which it may be set.
model ConfigKeyCatalog {
  key          String   @id
  type         String // BOOL | INT | ENUM | STRING
  allowedScope String[] @map("allowed_scope") // subset of TENANT | ENTITY | STORE
  enumValues   String[] @default([]) @map("enum_values") // only for type=ENUM
  defaultValue String   @map("default_value")
  description  String
  sinceVersion String   @map("since_version")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("config_key_catalog")
}

/// S223 — A scoped, effective-dated configuration value version.
/// Scope resolution (BR223-2): STORE -> ENTITY -> TENANT -> catalog default.
/// Version lifecycle (BR223-3): SCHEDULED (future-dated) -> EFFECTIVE -> SUPERSEDED.
model ConfigSetting {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  key           String
  type          String // denormalized from catalog for validation-at-read
  scope         String // TENANT | ENTITY | STORE
  entityId      String?   @map("entity_id") // required when scope=ENTITY or STORE
  storeId       String?   @map("store_id") // required when scope=STORE
  value         String // typed by `type`; validated on write
  effectiveFrom DateTime  @map("effective_from")
  status        String    @default("SCHEDULED") // SCHEDULED | EFFECTIVE | SUPERSEDED
  actor         String
  createdAt     DateTime  @default(now()) @map("created_at")
  supersededAt  DateTime? @map("superseded_at")

  @@index([tenantId, key])
  @@index([tenantId, key, scope, entityId, storeId])
  @@index([effectiveFrom])
  @@map("config_setting")
}

/// AuditPort stub outbox (S007 dependency). Shared table — created by the first
/// Sprint-1 story to merge (auth-service S206). Modeled here for cross-service
/// write access; the migration uses CREATE TABLE IF NOT EXISTS so it is idempotent.
model AuditOutboxEvent {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  docType     String    @map("doc_type")
  docId       String    @map("doc_id")
  action      String
  before      Json?
  after       Json?
  actor       String
  publishedAt DateTime? @map("published_at")
  retryCount  Int       @default(0) @map("retry_count")
  lastError   String?   @map("last_error")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, retryCount])
  @@map("audit_outbox")
}

/// S208 — Per-legal-entity fiscal calendar. One calendar per entity (BR208-1).
/// Refactored from the eom-service prototype (KOMFCAL / FIX-021), which was
/// tenant-scoped — the tenant=entity conflation packet §0 forbids. Structure
/// becomes immutable (LOCKED) once any generated period has postings (BR208-4).
model FiscalCalendar {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  entityId     String    @map("entity_id")
  fyStartMonth Int       @map("fy_start_month") @db.SmallInt // 1-12
  structure    String // TWELVE | TWELVE_PLUS_13TH
  status       String    @default("DEFINED") // DEFINED | LOCKED
  actor        String
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  lockedAt     DateTime? @map("locked_at")

  periods FiscalPeriod[]

  @@unique([entityId])
  @@index([tenantId])
  @@map("fiscal_calendar")
}

/// S208 — Generated fiscal period. Created FUTURE (BR208-2); S209 owns the
/// opening/close lifecycle. 13th period flagged adjustmentsOnly (BR208-3).
/// code = YYYY-MM (periods 1-12) or YYYY-13 (13th). Deterministic date->period
/// resolution (BR208-5) is a platform API consumed by S013 posting.
model FiscalPeriod {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  entityId        String   @map("entity_id")
  calendarId      String   @map("calendar_id")
  fiscalYear      Int      @map("fiscal_year")
  periodNumber    Int      @map("period_number") @db.SmallInt // 1-13
  code            String // YYYY-MM | YYYY-13
  startDate       DateTime @map("start_date") @db.Date
  endDate         DateTime @map("end_date") @db.Date
  status          String   @default("FUTURE") // FUTURE | OPEN | SOFT_CLOSED | HARD_CLOSED | LOCKED
  adjustmentsOnly Boolean  @default(false) @map("adjustments_only")
  hasPostings     Boolean  @default(false) @map("has_postings")
  openedBy        String?  @map("opened_by")
  openedAt        DateTime? @map("opened_at")
  // S008 — set/cleared by the enforce_period_transition() DB trigger, never
  // directly by application code (see 20260728010000_s008_period_close_control).
  // closedBy/closedAt reflect only the MOST RECENT close-family transition —
  // cleared to NULL on reopen. Full history lives in FiscalPeriodTransition.
  closedBy        String?  @map("closed_by")
  closedAt        DateTime? @map("closed_at")
  // lockedBy/lockedAt are write-once in normal operation: LOCKED is terminal
  // in S008 v1 (no unlock path exists — see S008 Story Contract §LOCKED).
  lockedBy        String?  @map("locked_by")
  lockedAt        DateTime? @map("locked_at")
  createdAt       DateTime @default(now()) @map("created_at")

  calendar    FiscalCalendar             @relation(fields: [calendarId], references: [id])
  transitions FiscalPeriodTransition[]

  @@unique([entityId, code])
  @@unique([entityId, fiscalYear, periodNumber])
  @@index([tenantId, entityId, fiscalYear])
  @@index([entityId, startDate, endDate])
  @@index([entityId, status])
  @@map("fiscal_period")
}

/// S008 — append-only period status-transition ledger. Written ONLY by the
/// enforce_period_transition() trigger via the SECURITY DEFINER function
/// record_period_transition() (never directly by amacc_app — see the S008
/// migration for the full RLS/privilege hardening). Independent of, and in
/// addition to, S007 audit events: this table protects against an
/// application-code path that forgets to write an S007 event; it commits or
/// rolls back atomically with its enclosing transaction, same as any other
/// row (see S008 Story Contract §Atomicity — it is not an independent
/// durability guarantee beyond normal transaction semantics).
model FiscalPeriodTransition {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  entityId    String   @map("entity_id")
  periodId    String   @map("period_id")
  fromStatus  String   @map("from_status")
  toStatus    String   @map("to_status")
  actor       String
  occurredAt  DateTime @default(now()) @map("occurred_at")

  period FiscalPeriod @relation(fields: [periodId], references: [id])

  @@index([tenantId, periodId, occurredAt])
  @@map("fiscal_period_transition")
}

/// S008 — same-database attestation that a real, permission-checked
/// fiscal.je.mark_adjusting decision was made for a given draft, verified by
/// the enforce_period_postable() posting trigger before it will accept
/// is_adjusting=true into a SOFT_CLOSED period. Written by the application
/// (DraftService) at the moment the S207 check succeeds — a DB trigger
/// cannot itself call the cross-service S207 permission check. See S008
/// Story Contract §Adjusting-Entry Raw-SQL Control for the disclosed
/// residual gap (a privileged raw-SQL session could still forge this row
/// directly) and the accompanying risk-acceptance note.
model AdjustingEntryAttestation {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  draftId         String   @unique @map("draft_id")
  attestedBy      String   @map("attested_by")
  reason          String
  correctionRef   String?  @map("correction_ref")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("adjusting_entry_attestation")
}

/// Domain-event outbox for reliable delivery of coa-service events
/// (config.changed, and later chart/fiscal events). Mirrors tenant_outbox_events.
model CoaOutboxEvent {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  eventType   String    @map("event_type")
  aggregateId String    @map("aggregate_id")
  payload     Json
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([publishedAt])
  @@map("coa_outbox_events")
}

/// S210 — Entity-scoped Chart of Accounts master. New canonical account table
/// distinct from the legacy gl-service `gl_accounts` (tenant-scoped, no entity
/// dimension). BR210-1 number unique per entity; BR210-2 type immutable once
/// hasPostings; BR210-3 normalBalance defaulted by type, contra override needs a
/// reason; BR210-4 deactivation blocked while balance != 0; BR210-5 non-postable
/// summary accounts reject journal lines (enforced at S013). balance/hasPostings
/// are maintained by the S013 posting path.
model GlAccount {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  entityId      String   @map("entity_id")
  accountNumber String   @map("account_number") @db.VarChar(5)
  name          String   @db.VarChar(120)
  type          String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  normalBalance String   @map("normal_balance") // DR | CR
  isContra      Boolean  @default(false) @map("is_contra")
  contraReason  String?  @map("contra_reason")
  postable      Boolean  @default(true)
  parentId      String?  @map("parent_id") // S211 hierarchy (single-parent)
  parentEffectiveFrom DateTime? @map("parent_effective_from") // S211 effective-dated re-parent
  status        String   @default("ACTIVE") // ACTIVE | INACTIVE
  balance       Decimal  @default(0) @db.Decimal(15, 2)
  hasPostings   Boolean  @default(false) @map("has_postings")
  version       Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([entityId, accountNumber])
  @@index([tenantId])
  @@index([tenantId, entityId])
  @@index([entityId, status])
  @@index([entityId, parentId])
  @@map("gl_account")
}

// S211 — append-only effective-dated re-parent trail (BR211-3).
model GlAccountReparent {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  entityId      String   @map("entity_id")
  accountId     String   @map("account_id")
  oldParentId   String?  @map("old_parent_id")
  newParentId   String?  @map("new_parent_id")
  effectiveFrom DateTime @map("effective_from")
  actor         String
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([accountId, effectiveFrom])
  @@index([tenantId, entityId])
  @@map("gl_account_reparent")
}

// S010 — canonical COA seed execution record (idempotency + audit).
model CoaSeedRun {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  entityId        String   @map("entity_id")
  manifestVersion String   @map("manifest_version")
  createdCount    Int      @default(0) @map("created_count")
  mergedCount     Int      @default(0) @map("merged_count")
  conflictCount   Int      @default(0) @map("conflict_count")
  actor           String
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tenantId, entityId, createdAt])
  @@map("coa_seed_run")
}

// S212 — journal source registry (manual GJ + reserved system sources).
model JournalSource {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  code           String   @db.VarChar(6)
  numericAlias   Int?     @map("numeric_alias") // reserved pending UQ-13
  name           String   @db.VarChar(120)
  sourceClass    String   @map("source_class") // MANUAL | SYSTEM
  reserved       Boolean  @default(false)
  autoPost       Boolean  @default(false) @map("auto_post")
  yearEndOnly    Boolean  @default(false) @map("year_end_only")
  thirteenthOnly Boolean  @default(false) @map("thirteenth_only")
  status         String   @default("ACTIVE")
  version        Int      @default(1)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, code])
  @@index([tenantId, sourceClass, status])
  @@map("journal_source")
}

model JournalSequence {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  sourceCode String   @map("source_code") @db.VarChar(6)
  entityId   String   @map("entity_id")
  periodCode String   @map("period_code") @db.VarChar(7) // YYYY-MM
  nextSeq    Int      @default(1) @map("next_seq")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, sourceCode, entityId, periodCode])
  @@map("journal_sequence")
}

model SequenceGapLog {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  sourceCode     String   @map("source_code") @db.VarChar(6)
  entityId       String   @map("entity_id")
  periodCode     String   @map("period_code") @db.VarChar(7) // YYYY-MM
  expectedNumber String   @map("expected_number") @db.VarChar(40)
  expectedSeq    Int      @map("expected_seq")
  reason         String
  actor          String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([tenantId, entityId, periodCode, createdAt])
  @@map("sequence_gap_log")
}

// S013 — Balanced Journal Posting: the single point of ledger truth. Entries are
// created directly POSTED (no AI review gate / auto-approve). Immutable once
// posted (BR013-7): the only correction path is a linked reversal (S218), which
// mints a NEW entry. All money NUMERIC(15,2). DR=CR enforced by a DEFERRABLE
// constraint trigger (trg_je_balanced) plus the pure evaluator in domain/journal-posting.
model JournalEntry {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  entityId       String   @map("entity_id")
  journalNumber  String   @map("journal_number")
  sourceCode     String   @map("source_code")
  periodId       String   @map("period_id")
  periodCode     String   @map("period_code")
  entryDate      DateTime @map("entry_date") @db.Date
  memo           String?  @db.VarChar(500)
  status         String   @default("POSTED") // POSTED | REVERSED
  idempotencyKey String   @map("idempotency_key")
  totalDebits    Decimal  @default(0) @map("total_debits") @db.Decimal(15, 2)
  totalCredits   Decimal  @default(0) @map("total_credits") @db.Decimal(15, 2)
  reversalOf     String?  @map("reversal_of") // S218 linkage
  reversedBy     String?  @map("reversed_by") // S218 back-link
  reversalReason String?  @map("reversal_reason") @db.VarChar(500)
  draftId        String?  @map("draft_id") // S216 POSTED-LINKED back-ref
  postedBy       String   @map("posted_by")
  postedAt       DateTime @default(now()) @map("posted_at")
  createdAt      DateTime @default(now()) @map("created_at")
  // S008 — per-journal adjusting-entry attribute (BR008-ADJ). Not inferred
  // from the fiscal period; only settable by a preparer holding
  // fiscal.je.mark_adjusting, verified against AdjustingEntryAttestation at
  // posting time by the enforce_period_postable() trigger. Immutable once
  // POSTED (enforced by the same trigger's BEFORE UPDATE guard).
  isAdjusting        Boolean @default(false) @map("is_adjusting")
  adjustingReason    String? @map("adjusting_reason") @db.VarChar(500)
  adjustingCorrectionRef String? @map("adjusting_correction_ref") @db.VarChar(120)

  lines JournalLine[]

  @@unique([entityId, journalNumber])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, entityId])
  @@index([tenantId, journalNumber])
  @@index([entityId, periodCode])
  @@index([reversalOf])
  @@index([reversedBy])
  @@map("journal_entry")
}

model JournalLine {
  id             String   @id @default(uuid())
  journalEntryId String   @map("journal_entry_id")
  tenantId       String   @map("tenant_id")
  lineIndex      Int      @map("line_index")
  accountId      String   @map("account_id")
  accountNumber  String   @map("account_number") @db.VarChar(5)
  storeId        String   @map("store_id")
  deptCode       String?  @map("dept_code")
  controlNumber  String?  @map("control_number")
  applyNumber    String?  @map("apply_number")
  dr             Decimal  @default(0) @db.Decimal(15, 2)
  cr             Decimal  @default(0) @db.Decimal(15, 2)
  memo           String?  @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")

  entry JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  /// S011 — additive, optional (BR011-3: never affects balancing/posting math).
  analysisTags JournalLineAnalysisTag[]

  @@index([journalEntryId])
  @@index([accountId])
  @@index([tenantId])
  @@map("journal_line")
}

// Append-only ledger effect record (one row per posting x account).
model BalanceSnapshot {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  entityId       String   @map("entity_id")
  accountId      String   @map("account_id")
  journalEntryId String   @map("journal_entry_id")
  journalNumber  String   @map("journal_number")
  periodCode     String   @map("period_code")
  dr             Decimal  @default(0) @db.Decimal(15, 2)
  cr             Decimal  @default(0) @db.Decimal(15, 2)
  delta          Decimal  @default(0) @db.Decimal(15, 2)
  balanceAfter   Decimal  @default(0) @map("balance_after") @db.Decimal(15, 2)
  postedAt       DateTime @map("posted_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([entityId, accountId, periodCode])
  @@index([journalEntryId])
  @@map("balance_snapshot")
}

// S214 — Create & Save Draft Manual JE. A draft is a safe scratchpad that saves
// in ANY state (BR214-1, no validation on save). Lines are stored as JSON so a
// half-finished entry round-trips faithfully. Edit history is retained in
// ManualJeDraftRevision (BR214-3). Validation (S215), posting (S216) and void
// (S219) transition status; this story owns only DRAFT create/edit + attachments.
model ManualJeDraft {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  entityId            String?   @map("entity_id") // nullable: draft may start before an entity is chosen
  preparer            String // owning user (BR214-2 visibility)
  status              String    @default("DRAFT") // DRAFT | VALIDATED | POSTED_LINKED | VOIDED
  entryDate           DateTime? @map("entry_date") @db.Date
  sourceCode          String?   @map("source_code")
  memo                String?   @db.VarChar(500)
  lines               Json      @default("[]") // [{accountId,accountNumber,storeId,deptCode,controlNumber,applyNumber,dr,cr,memo}]
  version             Int       @default(1)
  validatedAt         DateTime? @map("validated_at")
  validationResult    Json?     @map("validation_result")
  postedJournalId     String?   @map("posted_journal_id")
  postedJournalNumber String?   @map("posted_journal_number")
  voidedAt            DateTime? @map("voided_at")
  voidReason          String?   @map("void_reason") @db.VarChar(500)
  // S032 — additive, nullable linkage fields. A draft created by hand (S214's
  // original path) never sets these; DraftService.create()/postDraft() treat
  // them as plain passthrough data so pre-S032 behavior is byte-identical
  // when absent (BR032-3 "generator is a client of the journal lifecycle,
  // never a second posting path").
  generatedFromTemplateId String? @map("generated_from_template_id") // S032 BR032-3 generation linkage
  generationBatchId       String? @map("generation_batch_id") // S032 BR032-4 idempotency batch tag
  reversalOfJournalId     String? @map("reversal_of_journal_id") // S032 BR032-5 — forwarded into PostingService.post's reversalOf on post (reuses S218 mirrored-linkage semantics)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")
  // S008 — draft-side mirror of the adjusting-entry attribute, carried
  // through to JournalEntry.isAdjusting on post. Changing this flag OR
  // adjustingReason on an already-VALIDATED draft resets it to DRAFT
  // (BR008-ADJ-2: an attestation change invalidates prior validation,
  // mirroring the existing line-edit invalidation rule).
  isAdjusting            Boolean @default(false) @map("is_adjusting")
  adjustingReason        String? @map("adjusting_reason") @db.VarChar(500)
  adjustingCorrectionRef String? @map("adjusting_correction_ref") @db.VarChar(120)

  revisions   ManualJeDraftRevision[]
  attachments Attachment[]

  @@index([tenantId, preparer])
  @@index([tenantId, status])
  @@index([postedJournalId])
  @@index([generatedFromTemplateId])
  @@map("manual_je_draft")
}

// S214 — append-only draft edit history (BR214-3).
model ManualJeDraftRevision {
  id        String   @id @default(uuid())
  draftId   String   @map("draft_id")
  tenantId  String   @map("tenant_id")
  version   Int
  editor    String
  snapshot  Json
  createdAt DateTime @default(now()) @map("created_at")

  draft ManualJeDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, version])
  @@map("manual_je_draft_revision")
}

// S214 — attachment bound at the draft (BR214-4, basic upload; R1 hardening).
model Attachment {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  draftId    String   @map("draft_id")
  fileName   String   @map("file_name") @db.VarChar(255)
  mimeType   String   @map("mime_type") @db.VarChar(120)
  sizeBytes  BigInt   @map("size_bytes")
  storageKey String?  @map("storage_key")
  uploadedBy String   @map("uploaded_by")
  createdAt  DateTime @default(now()) @map("created_at")

  draft ManualJeDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@map("attachment")
}

/// S221 — GL Search. Persists a named, re-runnable search criteria set
/// (contract field 12: "Save a search and re-run it later" / BR221-2).
/// criteria is stored as JSON matching GLSearchCriteria (the same filter
/// shape accepted by GET /inquiry/search) so re-running never drifts from
/// the live query contract.
model SavedGlSearch {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  createdBy String   @map("created_by")
  name      String   @db.VarChar(120)
  criteria  Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, createdBy, name])
  @@index([tenantId, createdBy])
  @@map("saved_gl_search")
}

/// S011 — Analysis Codes and Accounting Dimensions (P01, confirmed slice only;
/// AMD-005/accumulator-adjacent behavior is explicitly excluded — see
/// P01_STORY_CONTRACTS.md "S011"). A tenant-defined dimension "type" (e.g.
/// Campaign, Project, Unit Group) — BR011-1. Deactivation only, never delete
/// (matches department-service.ts's registry convention); a type with any
/// active value cannot itself be deactivated out from under posted history.
model AnalysisCodeType {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  code                String    @db.VarChar(20)
  name                String    @db.VarChar(120)
  isActive            Boolean   @default(true) @map("is_active")
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")
  deactivatedAt        DateTime? @map("deactivated_at")
  deactivatedBy        String?   @map("deactivated_by")
  deactivationReason   String?   @map("deactivation_reason")

  values AnalysisCodeValue[]
  tags   JournalLineAnalysisTag[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("analysis_code_type")
}

/// S011 — a value within a code type (e.g. Campaign="SPRING24") — BR011-1.
/// BR011-4: inactive values reject on NEW lines but remain valid/immutable on
/// history already tagged with them.
model AnalysisCodeValue {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  typeId              String    @map("type_id")
  code                String    @db.VarChar(20)
  name                String    @db.VarChar(120)
  isActive            Boolean   @default(true) @map("is_active")
  version             Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")
  deactivatedAt        DateTime? @map("deactivated_at")
  deactivatedBy        String?   @map("deactivated_by")
  deactivationReason   String?   @map("deactivation_reason")

  type AnalysisCodeType     @relation(fields: [typeId], references: [id], onDelete: Cascade)
  tags JournalLineAnalysisTag[]

  @@unique([tenantId, typeId, code])
  @@index([tenantId, typeId, isActive])
  @@map("analysis_code_value")
}

/// S011 — BR011-2/BR011-3: additive child row per journal line x tag. Tags
/// are pure reporting dimensions; they never participate in the BR013
/// balancing/posting evaluator (domain/journal-posting.ts) and this table is
/// never read by PostingService's balance math. Written once, at post time,
/// alongside the JournalLine row it belongs to (same transaction) — BR011-1
/// AC: "the tag persists immutably with the posted line" (no update path;
/// only inserted when the line is created).
model JournalLineAnalysisTag {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  journalLineId  String   @map("journal_line_id")
  typeId         String   @map("type_id")
  valueId        String   @map("value_id")
  createdAt      DateTime @default(now()) @map("created_at")

  line  JournalLine       @relation(fields: [journalLineId], references: [id], onDelete: Cascade)
  type  AnalysisCodeType  @relation(fields: [typeId], references: [id])
  value AnalysisCodeValue @relation(fields: [valueId], references: [id])

  // A line may carry 0..N tags but never two values for the SAME type
  // (proposed default; a line tagged "Campaign=Spring24" and
  // "Campaign=Fall24" simultaneously is not a defined semantic).
  @@unique([journalLineId, typeId])
  @@index([tenantId, valueId])
  @@index([tenantId, typeId])
  @@index([journalLineId])
  @@map("journal_line_analysis_tag")
}

/// S032 — Recurring Journal Template master (BR032-1). Entity-scoped like
/// GlAccount (its lines reference GlAccount rows, which are entity-scoped).
/// Fixed debit/credit amounts only in R1 (BLK-23 — formula amounts excluded).
/// sourceCode is always the dedicated 'RT' code (BLK-20), never GJ/88.
model RecurringJournalTemplate {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  entityId     String   @map("entity_id")
  code         String   @db.VarChar(40)
  name         String   @db.VarChar(120)
  description  String?  @db.VarChar(500)
  sourceCode   String   @default("RT") @map("source_code")
  active       Boolean  @default(true)
  autoReverse  Boolean  @default(false) @map("auto_reverse") // BR032-5
  version      Int      @default(1) // BR032-7 — generation stamps this version; edits never touch past generations
  actor        String // creator/last-editor, mirrors ConfigSetting/FiscalCalendar convention
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  lines       RecurringJournalTemplateLine[]
  generations RecurringTemplateGeneration[]

  @@unique([tenantId, entityId, code])
  @@index([tenantId, entityId, active])
  @@map("recurring_journal_template")
}

/// S032 — fixed template line (BLK-23). Mirrors ManualJeDraft's JSON line
/// shape as real columns (a template is a governed master record, not a
/// freeform scratchpad, so BR032-1 validates it fully at save).
model RecurringJournalTemplateLine {
  id            String  @id @default(uuid())
  templateId    String  @map("template_id")
  tenantId      String  @map("tenant_id")
  lineIndex     Int     @map("line_index")
  accountId     String  @map("account_id")
  accountNumber String  @map("account_number") @db.VarChar(5)
  storeId       String  @map("store_id")
  deptCode      String? @map("dept_code")
  controlNumber String? @map("control_number")
  applyNumber   String? @map("apply_number")
  dr            Decimal @default(0) @db.Decimal(15, 2)
  cr            Decimal @default(0) @db.Decimal(15, 2)
  memo          String? @db.VarChar(500)

  template RecurringJournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([tenantId])
  @@map("recurring_journal_template_line")
}

/// S032 — one row per (template, period) generation (BR032-4 idempotency —
/// generating twice for the same template+period returns the existing draft,
/// never a duplicate). draftId links to the ManualJeDraft created via the
/// certified S214 path; reversalDraftId is populated once BLK-22's
/// auto-reverse draft is created at the original's post time (BR032-5).
model RecurringTemplateGeneration {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  templateId        String    @map("template_id")
  entityId          String    @map("entity_id")
  periodId          String    @map("period_id")
  periodCode        String    @map("period_code")
  batchId           String    @map("batch_id")
  draftId           String    @map("draft_id")
  templateVersion   Int       @map("template_version") // BR032-7 stamp
  reversalDraftId   String?   @map("reversal_draft_id")
  reversalPeriodId  String?   @map("reversal_period_id")
  generatedBy       String    @map("generated_by")
  generatedAt       DateTime  @default(now()) @map("generated_at")

  template RecurringJournalTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([tenantId, templateId, periodId])
  @@unique([tenantId, draftId])
  @@index([tenantId, batchId])
  @@map("recurring_template_generation")
}

// ═══════════════════════════════════════════════════════════════════════════
// S019/S020 — Posting Engine: DSL rule packs, deterministic evaluation and
// idempotent posting orchestration. This slice is a CLIENT of PostingService
// (posting-service.ts) — it never writes journal_entry/journal_line directly.
// ═══════════════════════════════════════════════════════════════════════════

/// S019 — Stable rule-pack identity (one row per packKey per tenant). Versions
/// carry all the actual content; this row exists so version history has a
/// stable parent to hang off regardless of how many versions are drafted.
model PostingRulePack {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  // CE-07 legal-entity isolation defect — a pack key is only stable identity
  // WITHIN a legal entity. Two entities in the same tenant configuring the
  // same packKey independently must get two separate parent rows, never one
  // shared row whose versions/activation state bleed across entities. See
  // migration 20260802010000_ce07_rule_pack_entity_isolation.
  entityId  String   @map("entity_id")
  packKey   String   @map("pack_key")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  versions PostingRulePackVersion[]

  @@unique([tenantId, entityId, packKey])
  @@index([tenantId])
  @@index([tenantId, entityId])
  @@map("posting_rule_pack")
}

/// S019 — Immutable-once-activated rule-pack version. `definition` is the
/// full validated Posting DSL v1 document (canonical AST); `contentHash` is
/// the stable sha256 over its canonical serialization. Lifecycle: DRAFT ->
/// VALIDATED -> ACTIVE -> SUPERSEDED (or DRAFT/VALIDATED -> REJECTED). Once a
/// version reaches ACTIVE, `enforce_posting_rule_pack_version_immutability()`
/// (see migration 20260729010000_add_posting_engine) blocks any further
/// change to `definition`/`content_hash` and blocks reverting status back to
/// DRAFT/VALIDATED — the DB trigger is the real backstop, not just the
/// application-layer guard in PostingEngineService.
model PostingRulePackVersion {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  rulePackId          String    @map("rule_pack_id")
  packKey             String    @map("pack_key")
  semver              String
  dslVersion           Int      @map("dsl_version")
  eventType           String    @map("event_type")
  eventSchemaVersions  String[] @map("event_schema_versions")
  entityId            String    @map("entity_id")
  effectiveFrom        DateTime @map("effective_from")
  effectiveTo          DateTime? @map("effective_to")
  journalSourceCode    String   @map("journal_source_code")
  matchStrategy        String   @map("match_strategy")
  noMatchBehavior      String   @map("no_match_behavior")
  definition           Json
  contentHash          String   @map("content_hash")
  status               String   @default("DRAFT") // DRAFT | VALIDATED | ACTIVE | SUPERSEDED | REJECTED
  validationFindings   Json?    @map("validation_findings")
  createdBy            String   @map("created_by")
  createdAt            DateTime @default(now()) @map("created_at")
  validatedAt          DateTime? @map("validated_at")
  activatedBy          String?  @map("activated_by")
  activatedAt          DateTime? @map("activated_at")
  supersededAt         DateTime? @map("superseded_at")

  rulePack   PostingRulePack    @relation(fields: [rulePackId], references: [id])
  executions PostingExecution[]

  // CE-07 legal-entity isolation defect — (tenantId, packKey, semver) alone
  // forbids two entities in the same tenant from EVER using the same
  // packKey+semver pair (e.g. both independently authoring their own
  // "1.0.0"), which is an explicit certification requirement. entityId join
  // makes the two entities' version histories fully independent.
  // Explicit short `map` names — the default Prisma-generated names for
  // these two exceed Postgres's 63-byte identifier limit and get silently
  // truncated (confirmed via a live-db apply); pinning them keeps the DDL
  // deterministic instead of relying on Postgres's own truncation.
  @@unique([tenantId, entityId, packKey, semver], map: "posting_rule_pack_version_entity_pack_semver_key")
  @@index([tenantId, eventType, status])
  @@index([tenantId, entityId, eventType, status], map: "posting_rule_pack_version_entity_event_status_idx")
  @@index([tenantId, rulePackId])
  @@map("posting_rule_pack_version")
}

/// S020 — One row per tenantId+eventId (the idempotency identity). Holds the
/// approved event representation, the pinned rule-pack version/rule that
/// evaluated it, and the resulting journal reference (a read-only pointer —
/// never a foreign key the posting engine can write through).
model PostingExecution {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  eventId            String    @map("event_id")
  eventType          String    @map("event_type")
  eventSchemaVersion String    @map("event_schema_version")
  // CE-07 legal-entity isolation defect — denormalized from the envelope's
  // own legalEntityId at claim time (see event-envelope.ts). Nullable
  // because historical rows predate this column and because a terminal
  // NO_RULE_MATCH/REJECTED outcome must still record the intended entity
  // even when no rule-pack version was ultimately selected — never inferred
  // from rulePackVersionId, which the entity/cross-entity certification
  // proves can legitimately be null.
  entityId           String?   @map("entity_id")
  sourceSystem       String    @map("source_system")
  sourceEntityType   String    @map("source_entity_type")
  sourceEntityId     String    @map("source_entity_id")
  correlationId      String    @map("correlation_id")
  causationId        String?   @map("causation_id")
  businessDate       DateTime  @map("business_date") @db.Date
  eventHash          String    @map("event_hash")
  eventEnvelope      Json      @map("event_envelope")
  status             String    // POSTED | NO_RULE_MATCH | IDENTITY_CONFLICT | REJECTED | FAILED
  rulePackVersionId  String?   @map("rule_pack_version_id")
  ruleId             String?   @map("rule_id")
  blueprintHash      String?   @map("blueprint_hash")
  journalEntryId     String?   @map("journal_entry_id")
  journalNumber      String?   @map("journal_number")
  failureReason      String?   @map("failure_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  rulePackVersion PostingRulePackVersion? @relation(fields: [rulePackVersionId], references: [id])
  attempts        PostingExecutionAttempt[]
  exceptions      PostingException[]
  replays         PostingExecutionReplay[]

  @@unique([tenantId, eventId])
  @@index([tenantId, eventType, status])
  @@index([tenantId, correlationId])
  @@index([tenantId, sourceEntityId])
  @@index([tenantId, entityId])
  @@map("posting_execution")
}

/// S020 — Append-only attempt ledger for a PostingExecution (retry/reconcile
/// history). Never updated or deleted, only inserted.
model PostingExecutionAttempt {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  executionId   String   @map("execution_id")
  attemptNumber Int      @map("attempt_number")
  outcome       String   // STARTED | POSTED | DUPLICATE | NO_RULE_MATCH | IDENTITY_CONFLICT | REJECTED | FAILED
  detail        Json?
  createdAt     DateTime @default(now()) @map("created_at")

  execution PostingExecution @relation(fields: [executionId], references: [id])

  @@unique([executionId, attemptNumber])
  @@index([tenantId])
  @@map("posting_execution_attempt")
}

/// S020 — Durable, queryable no-rule-match / identity-conflict record
/// (BR S020-F/BR S020-3d). Never silently dropped, never marks the event
/// "successful"; replay is explicitly out of scope for this story.
model PostingException {
  id                         String   @id @default(uuid())
  tenantId                   String   @map("tenant_id")
  executionId                String   @map("execution_id")
  reasonCode                 String   @map("reason_code") // NO_RULE_MATCH | EVENT_IDENTITY_CONFLICT
  reasonDetail                String  @map("reason_detail")
  eventType                  String   @map("event_type")
  eventSchemaVersion          String  @map("event_schema_version")
  rulePackVersionsConsidered  Json    @map("rule_pack_versions_considered")
  createdAt                  DateTime @default(now()) @map("created_at")

  execution PostingExecution @relation(fields: [executionId], references: [id])

  @@index([tenantId, reasonCode])
  @@index([tenantId, executionId])
  @@map("posting_exception")
}

/// CE-07/S023 (D-S023-25, D-S023-22 narrow scope) — dual-version replay
/// evidence. One row per authorized replay attempt against an existing
/// posting_execution row (never a second posting_execution row for the same
/// (tenantId, eventId) — the execution row itself is updated in place,
/// exactly like an ordinary posting attempt).
model PostingExecutionReplay {
  id                          String    @id @default(uuid())
  tenantId                    String    @map("tenant_id")
  executionId                 String    @map("execution_id")
  originalRulePackVersionId   String?   @map("original_rule_pack_version_id")
  replayRulePackVersionId     String?   @map("replay_rule_pack_version_id")
  originalFailureReasonCode   String?   @map("original_failure_reason_code")
  originalFailureReasonDetail String?   @map("original_failure_reason_detail")
  replayActor                 String    @map("replay_actor")
  replayReason                String    @map("replay_reason")
  originalBusinessDate        DateTime  @map("original_business_date") @db.Date
  originalAttemptedPeriodId   String?   @map("original_attempted_period_id")
  currentPostingPeriodId      String?   @map("current_posting_period_id")
  resultingStatus             String    @map("resulting_status")
  resultingJournalEntryId     String?   @map("resulting_journal_entry_id")
  resultingJournalNumber      String?   @map("resulting_journal_number")
  createdAt                   DateTime  @default(now()) @map("created_at")

  execution PostingExecution @relation(fields: [executionId], references: [id])

  @@index([tenantId, executionId])
  @@map("posting_execution_replay")
}
